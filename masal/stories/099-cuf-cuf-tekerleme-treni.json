 "guide": {
  "kazanim": [
   "MSB2 Müziksel Söyleme (alan becerisi): “Yağ satarım, bal satarım” oyun şarkısını doğru telaffuzla, gruba katılarak söyler (MSB öğrenme çıktısı: şarkı sözlerini doğru telaffuz eder — teyitsiz).",
   "MHB4 Müziksel Hareket (alan becerisi): Şarkının ritmine uyarak halkanın çevresinde tıpış tıpış yürür; hızlı-yavaş tempoyu hareketle gösterir (MHB öğrenme çıktısı: tempo farklılıklarını hareketle veya dansla gösterir — teyitsiz).",
   "OB5 Kültür Okuryazarlığı: Büyüklerden öğrenilen geleneksel bir çocuk oyununu tanır ve kuralına uyarak oynar.",
   "SDB2.2 İş Birliği ve D4 Dostluk: Arkadaşının üzüldüğünü fark eder, ebeliği paylaşan bir çözüm önerir."
  ],
  "once": [
   "Kapaktaki çocuklara bakın: “Sence parkta ne oynuyorlar?”",
   "“Yağ satarım, bal satarım” sözünü birlikte, el çırparak söyleyin. Ailenizde bu oyunu bilen var mı, sorun.",
   "Çocuk dostu sözler: “Yağ satarım, bal satarım, / Ustam gitmiş, ben satarım… / Arkana bak, arkana bak!”"
  ],
  "sirasi": [
   "2. sayfada Deniz yürürken siz de şarkıyı söyleyin; her dokunuşta bir adım, bir “tıpış”.",
   "3. sayfada tahmin sorusunda çocuğun gerekçesini dinleyin, doğru-yanlış demeyin.",
   "5. sayfada Deniz'in yüzüne birlikte bakın: dudak büküldü, omuzlar düştü. Sırayla Deniz'e, Ali'ye, Elif'e dokunun; “Sen olsan ne hissederdin?” diye sorun."
  ],
  "sonra": [
   "Oyunun sırasını parmakla sayın: önce şarkı, sonra mendil, sonra “Arkana bak!”",
   "Deniz neden üzüldü, ne olunca güldü? Elif'in fikri Deniz'e nasıl yardım etti?",
   "Başka kimler birlikte ebe olabilir? Oyunu herkes için daha eğlenceli yapan bir kural bulun."
  ],
  "sinif": {
   "ad": "Halkada Yağ Satarım",
   "sure": "15 dk",
   "materyal": "Bir yumuşak, oyalı mendil, geniş alan (tekerlekli sandalye ve yürüteçlerin rahat geçeceği genişlikte halka)",
   "adim": [
    "Çocuklar yere ya da sandalyeye halka olur, gözlerini önlerine çevirir.",
    "Ebe (ya da el ele iki ebe) şarkıyı söyleyerek halkanın dışında ritimle yürür; öğretmen tefle önce yavaş, sonra hızlı tempo verir.",
    "Şarkı bitince mendil birinin arkasına bırakılır; herkes “Arkana bak!” der.",
    "Mendili bulan kalkar, ebeyle birlikte bir tur yürür; kimse oyundan çıkmaz, ebe olmak ceza değildir (koşu yerine hızlı yürüyüş güvenlidir).",
    "Oyun sonunda sorun: “Ebe olunca nasıl hissettin? İki ebe olunca ne değişti?”"
   ]
  },
  "evSoru": [
   "Deniz neden üzüldü?",
   "Elif ne önerdi?",
   "Sen annenle, babanla ya da dedenle hangi eski oyunu oynamak istersin?"
