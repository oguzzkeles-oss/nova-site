 "guide": {
  "kazanim": [
   "beceri: MHB4 Müziksel Hareket (teyitsiz) — Harekete ve dansa eşlik eden ritimlerdeki tempo farklılıklarını hareketle veya dansla gösterir: tef şıkır şıkır hızlı çalınca hızlı, davul güm güm yavaş çalınca yavaş dans eder; müzik susunca durur.",
   "HSAB.3 (teyitsiz) — Jimnastik, dans ve hareket etkinliklerinden ritmik beceriler sergileyebilme; alt çıktı: ritim ve tempoya göre farklı şekillerde hareket eder. Çocuk heykel dansında ağaç, kedi gibi farklı donma biçimleri dener.",
   "SDB1.2 Kendini Düzenleme — Hareketini isteyerek durdurmak için bir yol kullanır: kendine “Dur!” der, derin nefes alır, sonra heykel olur. Kızgınlığını sözle anlatır (“Ayaklarım beni dinlemiyor!”).",
   "E2.5 Oyunseverlik ve D4 Dostluk — Can kendi zorlandığı anı paylaşıp arkadaşına sihirli bir söz önerir; Zeynep teşekkür eder, oyunu birlikte sürdürürler."
  ],
  "once": [
   "İlk sayfadaki tefi ve davulu gösterin: “Hangisi şıkır şıkır, hangisi güm güm çalar?”",
   "“Heykel dansı” oyununu bilen var mı? Kurallarını birlikte hatırlayın."
  ],
  "sirasi": [
   "2. sayfada durup sorun: “Zeynep'in bedeninde neler oluyor? Sen kızınca neler hissedersin?”",
   "3. sayfada tahmin sorusunu sorun; iki cevap da olumlu, çocuk Zeynep'in nasıl duracağını seçer.",
   "4. sayfada tef çalınca çocuklarla hızlı hızlı, davul çalınca yavaş yavaş süzülün; müzik susunca heykel olun."
  ],
  "sonra": [
   "Can'ın sihirli sözü neydi? “Önce Dur! de, sonra nefes al.” Birlikte deneyin.",
   "Zeynep'in duyguları masal boyunca nasıl değişti? (kızgın → üzgün → sakin → gururlu)",
   "Nur Öğretmen hapşırınca neden herkes güldü? Heykel olmak neden zor olabilir?"
  ],
  "sinif": {
   "ad": "Hızlı-Yavaş-Dur Heykel Dansı",
   "sure": "15 dk",
   "materyal": "Tef, davul (yoksa masa ve tahta kaşık), geniş boş alan",
   "adim": [
    "Tef hızlı çalınca hızlı, davul yavaş çalınca yavaş hareket edeceğimizi anlatın ve birkaç kez deneyin.",
    "Müzik susunca herkes kendine fısıltıyla “Dur!” der, bir derin nefes alır ve bir heykel olur (ağaç, kedi, uçak…).",
    "Oyunda elenen olmasın; kıpırdayan çocuk gülerek yeniden heykel olur. Sırayla çocuklar da tef çalıp tempo seçsin.",
    "Sonunda halkada oturup sorun: “Durmak ne zaman kolaydı, ne zaman zordu? Sana ne yardım etti?”"
   ]
  },
  "evSoru": [
   "Zeynep'in ayakları neden durmadı?",
   "Can Zeynep'e hangi sihirli sözü söyledi?",
   "Sen heykel olsan ne olurdun?"
  ],
  "evEtk": {
   "ad": "Mutfak Heykel Dansı",
   "d": "Evde bir şarkı açın ya da tencere kapağıyla ritim tutun. Bazen hızlı, bazen yavaş çalın; müziği durdurunca herkes “Dur!” deyip nefes alsın ve heykel olsun. Sıra çocuğa da gelsin: müziği o yönetsin."
  },
  "aileNotu": "Bugün “Müzik Durunca Dur!” masalını okuduk. Zeynep heykel dansında bir türlü duramıyor ve kızıyor; arkadaşı Can ona sihirli sözünü öğretiyor: “Önce Dur! de, sonra nefes al.” Masal, hızlı-yavaş tempoyu hareketle göstermeyi ve isteyerek durabilmeyi (öz düzenleme) oyunla destekliyor. Evde heykel dansı oynarken kıpırdayan olursa gülerek yeniden deneyin; amaç kazanmak değil, durmayı birlikte keşfetmek."
 },
