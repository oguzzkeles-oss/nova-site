 "guide": {
  "kazanim": [
   "HSAB.2 Farklı ebat ve özellikteki nesneleri etkin bir şekilde kullanabilme: Kalın atkı, orta boy kurdele ve ince bağcık gibi farklı büyüklükteki nesneleri kavrar ve kullanır (HSAB.2.a, HSAB.2.c); kocamandan miniciğe fiyonk atmayı dener.",
   "SDB1.3 Kendine Uyarlama (Öz Yansıtma): “Yapamıyorum” yerine “henüz yapamıyorum” diyerek kendi öğrenmesine bakar; neyin kolay neyin zor olduğunu fark edip yolunu değiştirir (büyükten küçüğe çalışma).",
   "E1.3 Azim ve Kararlılık ve E1.4 Kendine İnanma (Öz Yeterlilik): Fiyonk çözülse de yeniden dener, başardığında “Kendim bağladım!” der. D3 Çalışkanlık: Başarının çalışarak geldiğini yaşar."
  ],
  "once": [
   "Kapağı gösterin: “Dedenin elindeki şey neye benziyor? Tavşan kulağına mı, kelebeğe mi?”",
   "Bağcıklı bir ayakkabı getirin. “Bunu kim bağlayabiliyor? Kim henüz öğreniyor?” diye sorun; iki cevap da olur.",
   "Sizin zorlanarak öğrendiğiniz bir şeyi anlatın (bisiklet, ıslık çalmak…)."
  ],
  "sirasi": [
   "2. sayfada Can'ın kızgın yüzünü birlikte taklit edin, sonra ellerinizi sıkıp gevşetin.",
   "3. sayfada “Hıııh… puuuf” diye birlikte iki kez nefes alın. “Henüz” sözcüğünü çocuğa tekrar ettirin. Tahmin sorusunda iki seçenek de doğru.",
   "4. sayfada iki parmağınızla tavşan kulağı yapın ve tekerlemeyi söyleyin: “Bir kulak, iki kulak, çaprazla, çek!”",
   "5. sayfada sırayı çocuğa söyletin: önce kocaman, sonra orta, en son minicik."
  ],
  "sonra": [
   "Can bağcığı bağlayamayınca ne hissetti? Kızınca bedeninde ne oldu? Nasıl sakinleşti?",
   "Dede “yapamıyorum” yerine hangi sözcüğü söyledi?",
   "Can neden önce atkıyla denedi? Kocaman kulaklar neden daha kolaydı?"
  ],
  "sinif": {
   "ad": "Kocamandan Miniciğe Fiyonk",
   "sure": "20 dk",
   "materyal": "Kalın ip ya da eski atkılar, orta boy kurdeleler, delikli karton ayakkabı kartları ve ayakkabı bağcıkları; yazısız, tavşan kulaklı adım resim kartları",
   "adim": [
    "Çocuklar önce iki parmakla havada tavşan kulakları yapıp tekerlemeyi söylesin: “Bir kulak, iki kulak, çaprazla, çek!”",
    "Kalın atkı ya da iple bir sandalye ayağına kocaman fiyonk atın; çocuklar sırayla denesin.",
    "Kurdeleyle bir oyuncak ayıya ya da hediye paketine orta boy fiyonk atın.",
    "Karton ayakkabı kartlarına bağcık geçirin ve minicik fiyonk deneyin. Olmayınca “Henüz!” deyip birlikte bir nefes alın; deneyen her çocuğu, sonucu ne olursa olsun, çabası için alkışlayın."
   ]
  },
  "evSoru": [
   "Sen hangi işi “henüz” yapamıyorsun? Nasıl öğrenebilirsin?",
   "Can kızınca ne yaptı? Sen kızınca ne yaparsın?",
   "Tavşan kulakları tekerlemesini bana söyler misin?"
  ],
  "evEtk": {
   "ad": "Tavşan Kulakları Çalışması",
   "d": "Bir hafta boyunca her gün birkaç dakika fiyonk çalışın: önce kalın bir atkı ya da ip, sonra kurdele, en son gerçek bağcık. Çocuğunuzun ayakkabısı ayağındayken değil, önce kucağında ya da masada çalışmak daha kolaydır. Sonuca değil çabaya odaklanın: “Bugün bir kulağı sen yaptın!” Olmadığında “henüz” sözcüğünü birlikte kullanın."
  },
  "aileNotu": "Bugün “Tavşan Kulakları” masalını okuduk. Can ayakkabı bağcıklarını kendisi bağlamak istedi; fiyonk çözülünce çok kızdı ve “Ben yapamıyorum!” dedi. Dedesi ona “henüz yapamıyorum” demeyi, birlikte nefes almayı ve tavşan kulakları yöntemini gösterdi. Bağcık bağlamak 5-6 yaşta parmakların ve sabrın birlikte geliştiği bir iştir; evde kalın iple başlayıp adım adım inceltmek ve çabayı fark etmek çok yardımcı olur."
 },
