 "guide": {
  "kazanim": [
   "FAB.1 — Gündelik yaşamda fenle ilgili olaylara/olgulara ve durumlara yönelik bilimsel gözlem yapabilme: Tohumun toprakta beklediğini, suyla ve güneşle önce filiz, sonra yaprak, tomurcuk ve çiçek olduğunu gözler; büyüme aşamalarını sırayla söyler.",
   "TAOB.2 — Görsel materyallerden anlamlar üretebilme (TAOB.2.a): Sayfalardaki resimlerden tohumun nasıl değiştiğini okur; resimdeki bostanı kendi bahçesi, balkonu ya da saksısıyla ilişkilendirir ve “Elif beklerken ne yapacak?” sorusunda görsellerden tahmin yürütür.",
   "SDB1.2 Kendini Düzenleme — Elif gibi sabırsızlandığını fark eder (yanaklar ısınır), derin nefes alma ve şarkı söyleme gibi bekleme yolları dener.",
   "E1.1 Merak — “Tohumun içinde ne oluyor?” diye merak eder, her gün gidip bakmanın keyfini yaşar.",
   "D12 Sabır — Bir şeyin olması için zaman gerektiğini fark eder; beklerken kendi işini (sulama) sürdürür."
  ],
  "once": [
   "Kapaktaki tohumu gösterin: “Bu minicik tohumdan ne çıkar sence? Ne kadar sürede?” diye sorun.",
   "Mümkünse gerçek bir ayçiçeği ya da fasulye tohumunu gösterin ve büyüteçle bakın. Tohumları bir yetişkin dağıtsın ve toplasın; tohumlar ağza, buruna, kulağa konmaz. Büyüteçle bakarken tohum tabakta dursun."
  ],
  "sirasi": [
   "2. sayfada Elif'in yüzünü gösterin: “Elif ne hissediyor? Yanakların ısınınca sen ne yaparsın?”",
   "3. sayfada Elif'le birlikte derin bir nefes alın: burundan al, “ohhh” diye bırak. Tahmin sorusunda iki cevabı da kabul edin.",
   "4. sayfada Elif'in şarkısını birlikte söyleyin: “Su, güneş, biraz sabır. Tohumcuk yavaş uyanır!”",
   "5. sayfada her dokunuşta “Bir gün geçti… bir hafta geçti…” diyerek zamanın geçtiğini hissettirin; Elif'in şarkısını yine birlikte söyleyin."
  ],
  "sonra": [
   "Tohum ertesi sabah neden çiçek olmadı?",
   "Elif beklerken hangi yolları buldu?",
   "Tohum önce ne oldu, sonra ne oldu, en son ne oldu?"
  ],
  "sinif": {
   "ad": "Sabır Saksısı ve Gözlem Takvimi",
   "sure": "20 dk (sonra her gün 5 dk)",
   "materyal": "Şeffaf plastik bardaklar, pamuk ya da toprak, fasulye tohumları, sulama kabı, resimli gözlem takvimi (çizim kutuları)",
   "adim": [
    "Tohumları öğretmen tek tek verir; iş bitince artanları toplar.",
    "Her çocuk şeffaf bardağa pamuk/toprak koyup kenara bir fasulye tohumu yerleştirsin; sulama sorumlusu sırayla seçilsin.",
    "Her sabah çember saatinde bardaklara bakın; çocuklar gördüklerini gözlem takviminin o günkü kutusuna çizsin (tohum, filiz, yaprak).",
    "Beklemek zor geldiğinde sınıfça Elif'in şarkısını söyleyin; bir hafta sonra çizimleri sırayla dizip “Önce… sonra…” diye anlatın. Fasulye 3–7 günde filizlenir; ayçiçeğinin çiçek açması ise aylar sürer. Masaldaki “günler geçti” bunu anlatır."
   ]
  },
  "evSoru": [
   "Elif ve dedesi bostana ne ekti?",
   "Elif beklemek zor gelince ne yaptı?",
   "Sen en son neyi sabırla bekledin?"
  ],
  "evEtk": {
   "ad": "Mutfak penceresinde fasulye",
   "d": "Tohumu çocuğunuzla birlikte, gözetiminizde yerleştirin: ıslak pamuğa bir kuru fasulye koyun, şeffaf bir kavanozda pencere önüne bırakın. Fasulye 3–7 günde filizlenir. Her gün birlikte bakın; çocuğunuz gördüğünü bir kâğıda çizsin. Bekleme zorlaşınca Elif'in şarkısını söyleyin."
  },
  "aileNotu": "Bugün “Elif'in Sabırlı Tohumu” masalını okuduk. Elif dedesiyle bir tohum ekiyor, ertesi gün çiçek çıkmayınca sabırsızlanıyor; derin nefes alıyor ve beklerken kendi sulama şarkısını uyduruyor. Evde bekleme anlarında (yemek pişerken, sıra beklerken) çocuğunuzun duygusunu adlandırıp “Elif gibi bir nefes alalım mı?” diyebilirsiniz. Birlikte ekeceğiniz küçük bir tohum, beklemenin keyfini gösteren güzel bir deneyim olur."
 },
