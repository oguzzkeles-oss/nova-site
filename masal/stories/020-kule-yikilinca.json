 "guide": {
  "kazanim": [
   "TADB.4 — Dinlediği/izlediği hikâyeye ilişkin duygu ve düşüncelerini söyler: Zeynep'in öfkesini, Ekin'in şaşkınlığını ve sondaki kahkahayı kendi sözleriyle anlatır.",
   "SDB1.2 Kendini Düzenleme — Öfkelendiğinde bedenindeki işaretleri (kızaran yanak, güm güm atan kalp, yere vuran ayak) fark eder ve nefesle sakinleşmeyi dener.",
   "E1.3 Azim ve Kararlılık — Yıkılan kuleyi vazgeçmeden yeniden kurar: “Yine yaparız!”",
   "D12 Sabır — Kardeşiyle sıra alarak (“bir blok sen, bir blok ben”) birlikte oynar."
  ],
  "once": [
   "Kapaktaki kuleyi göster: “Bu kule yıkılırsa Zeynep ne hisseder?” diye sor.",
   "“Kızgın yüz nasıl olur?” deyip birlikte kızgın, sonra sakin bir yüz yapın."
  ],
  "sirasi": [
   "3. sayfada kalbe dokunun; kızınca bedende neler olduğunu (yanaklar, eller, kalp) konuşun. Tahmin sorusunda iki cevabı da kabul edin.",
   "4. sayfada nefes oyununu hep birlikte üç kez yapın: burundan çiçeği kokla, ağızdan babanın parmak mumunu üfle. Gerçek mum yakmayın.",
   "5. sayfada Zeynep'in Ekin'in de oynamak istediğini fark ettiğini konuşun; kulenin bloklarını alttan üste birlikte sayın: bir, iki, üç, dört, beş."
  ],
  "sonra": [
   "Zeynep ne zaman kızdı? Sonra nasıl sakinleşti?",
   "Sence Ekin kuleye neden dokundu? Ne yapmak istemiş olabilir?",
   "Kule sonda yine yıkıldı. Bu kez neden kimse kızmadı?"
  ],
  "sinif": {
   "ad": "Kule Kur, Nefes Al",
   "sure": "20 dk",
   "materyal": "Tahta ya da plastik bloklar, kızgın–sakin–mutlu yüz kartları",
   "adim": [
    "Küçük gruplar beş bloklu kuleler kursun; blokları birlikte sayın.",
    "Öğretmen kendi kulesini yavaşça devirsin. Çocuklar “Kule yıkılınca ne hissedersin?” sorusuna yüz kartıyla cevap versin ve nedenini söylesin.",
    "Hep birlikte üç kez “çiçeği kokla, mumu üfle” nefesini yapın. Sonra ikili olup “bir blok sen, bir blok ben” diyerek kuleyi sırayla yeniden kurun."
   ]
  },
  "evSoru": [
   "Zeynep neden kızdı?",
   "Baba Zeynep'e nasıl yardım etti?",
   "Sen kızınca bedeninde neler olur? Sonra ne yaparsın?"
  ],
  "evEtk": {
   "ad": "Parmak mum nefesi",
   "d": "Gerçek mum yakmadan, işaret parmağınızı mum gibi kaldırın. Burnunuzdan çiçek koklar gibi nefes alın, ağzınızdan parmak mumu yavaşça üfleyin. Sakin bir anda birlikte üç kez deneyin; kızgın anlarda hatırlatmak kolaylaşır."
  },
  "aileNotu": "Bugün “Kule Yıkılınca” masalını okuduk. Zeynep, minik kardeşi kulesini yıkınca çok kızıyor; babasıyla nefes alarak sakinleşiyor ve kuleyi kardeşiyle sırayla yeniden kuruyor. Evde çocuğunuzun kızgınlığını adlandırıp kabul edebilirsiniz: “Kulen yıkıldı, çok kızdın.” “Çiçeği kokla, mumu üfle” nefesini gerçek mum yakmadan, parmağınızı mum yaparak birlikte deneyebilirsiniz."
 },
