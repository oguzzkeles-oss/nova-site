    },
    "tarcin": {
     "say": "Woof woof!"
    },
    "can": {
     "say": "Stop!"
    },
    "lamba": {
     "say": "Look! The red man."
    },
    "araba": {
     "say": "Listen! Vroom!"
    }
   },
   "mech": {
