{
 "id": "005-ela-okulun-ilk-gunu",
 "lang": "en",
 "title": "Ela's First Day at School",
 "theme": "Settling in at school",
 "blurb": "On the first morning of school, Ela doesn't want to leave her mum, and her tummy is all in knots. She finds the shy toys, tells her new friend Can the order of the day, and Mum comes back just like she said.",
 "voiceNames": {
  "ela": "Ela",
  "anne": "Mum (Ela's mum)",
  "ogretmen": "Miss Nur",
  "can": "Can",
  "baba": "Dad (Can's dad)"
 },
 "pages": [
  {
   "text": "It was morning. Ela came to school. She would not let go of Mum's hand. She hugged Fluffy, her teddy bear. Miss Nur smiled: “Good morning, Ela!” Ela hid behind her mum.",
   "hits": {
    "ogretmen": {
     "say": "Good morning, Ela! Welcome!"
    },
    "ela": {
     "say": "Mummy, can we go home?"
    },
    "anne": {
     "say": "Your teacher said good morning to you."
    },
    "saat": {
     "say": "Tick tock! It's morning."
    }
   },
   "hint": "Touch the teacher!",
   "ask": "What do you say when you come to school in the morning? Who do you say it to?"
  },
  {
   "text": "Ela was scared. She hugged Mum tight, tight, tight. Her tummy felt all in knots. Mum sat down beside her: “First play, then lunch, then a story. Then I come back!”",
   "hits": {
    "anne": {
     "say": "Then I come back. I promise!"
    },
    "ela": {
     "say": "Don't go, Mum!"
    },
    "oyun": {
     "say": "First, play!"
    },
    "yemek": {
     "say": "Then, lunch!"
    },
    "masal": {
     "say": "Then, a story!"
    }
   },
   "hint": "Touch Mum!",
   "ask": "Why was Ela's tummy all in knots? Have you ever felt like that?"
  },
  {
   "text": "One kiss, one hug, one wave… Mum went away. Ela felt so sad. Her eyes filled with tears. Fluffy's eyes did too.",
   "hits": {
    "anne": {
     "say": "See you this afternoon, Ela!"
    },
    "ela": {
     "say": "Bye-bye, Mum…"
    },
    "ogretmen": {
     "say": "I'm here, Ela. Shall we look around together?"
    }
   },
   "predict": {
    "q": "What do you think Ela will do now?",
