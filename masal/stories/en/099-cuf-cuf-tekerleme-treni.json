{
 "id": "099-cuf-cuf-tekerleme-treni",
 "lang": "en",
 "title": "Butter to Sell, Honey to Sell",
 "theme": "A traditional circle game: walking in rhythm to a song and being ‘it’ together",
 "blurb": "Ali, Deniz and Elif play their grandpas' game in the park: Butter to sell, honey to sell! Deniz is sad when she is always ‘it’. Then Elif has a lovely idea.",
 "voiceNames": {
  "ali": "Ali",
  "deniz": "Deniz",
  "elif": "Elif"
 },
 "pages": [
  {
   "text": "Three friends in the park: Ali, Deniz, Elif. “Let's play Butter to Sell!” said Ali. “Grandpa taught me!” Quick, a circle on the grass!",
   "hits": {
    "ali": {
     "say": "My grandpa taught me this game!"
    },
    "deniz": {
     "say": "Let's make a circle, a circle!"
    },
    "elif": {
     "say": "I'm in! Let's start!"
    }
   },
   "hint": "Touch Ali!",
   "ask": "Which game do you play with your friends in the park? Who taught you?"
  },
  {
   "text": "Deniz was it. In her hand, a lacy hanky. Round the circle she went, pit-a-pat, pit-a-pat. All together, the song began: “Butter to sell, honey to sell!”",
   "hits": {
    "deniz": {
     "say": "Butter to sell, honey to sell!"
    },
    "ali": {
     "say": "Clap clap! Clap clap!"
    },
    "elif": {
     "say": "Clap clap! I'm not looking behind me!"
    }
   },
   "mech": {
    "done": "Pit-a-pat, all the way round the circle!",
    "msg": "You walked to the song!"
   },
   "hint": "Walk with Deniz!",
   "ask": "Come on, you say it too: “Butter to sell, honey to sell!” Shall we walk fast or slow?"
  },
  {
   "text": "The song ended. Shhh! Nobody looked behind. Deniz quietly put the hanky down on the grass. But behind whom?",
   "hits": {
    "deniz": {
     "say": "Shhh! Nobody look!"
    },
    "ali": {
     "say": "I'm not looking behind me, promise!"
    },
    "elif": {
     "say": "My heart's going pitter patter!"
    }
   },
   "predict": {
    "q": "Who do you think the hanky is behind?",
    "res": "Let's find out!",
    "opts": [
     {
      "l": "Behind Ali"
     },
     {
      "l": "Behind Elif"
     }
    ]
   },
   "hint": "Touch Deniz!",
   "ask": "Who do you think Deniz left the hanky behind? Why do you think that?"
  },
  {
   "text": "“Ali, look behind you!” laughed Elif. Ali turned round. Where's the hanky? Ali grabbed the hanky. Run, run, run!",
   "hits": {
    "ali": {
     "say": "Huh? Where's the hanky?"
    },
    "elif": {
     "say": "Ali, look behind you!"
    },
    "deniz": {
     "say": "Run, run! You can't catch me!"
    }
   },
   "mech": {
    "done": "You found it! Go on, Ali, run, run!",
    "msg": "You found the hanky!"
   },
   "hint": "Find the hanky!",
   "ask": "Where was the hanky? In front of Ali, or behind him?"
  },
  {
   "text": "Ali caught Deniz. Deniz was it again! Her lip wobbled, her shoulders drooped. “I'm always it, always all on my own!” she said. Elif clapped her hands: “Shall we be it together?”",
   "hits": {
    "deniz": {
     "say": "I always go round all on my own…"
    },
    "ali": {
     "say": "Are you sad, Deniz?"
    },
    "elif": {
     "say": "Shall we be it together?"
    }
   },
   "mech": {
    "done": "Deniz's face lit up!",
    "msg": "You understood Deniz!"
   },
   "hint": "How is Deniz feeling?",
   "ask": "Why was Deniz sad? What does your face look like when you're sad? Show me!"
  },
  {
   "text": "Deniz and Elif went round side by side. “Butter to sell, honey to sell!” Down went the hanky. “Ali, look behind you!” they laughed. Ali grabbed the hanky: “Who'll be it with me?”",
   "hits": {
    "elif": {
     "say": "Butter to sell, honey to sell!"
    },
    "deniz": {
     "say": "Being it together is lovely!"
    },
    "ali": {
     "say": "Found it! Who'll be it with me?"
    }
   },
   "mech": {
    "done": "Song, hanky, look behind you! Hooray!",
    "msg": "You played the game in order!"
   },
   "hint": "Start the song first!",
   "ask": "What happened first in the game, and what happened next? Who would you like to be it with?"
  }
 ],
 "guide": {
  "kazanim": [
   "MSB2 Musical Singing (field skill): Sings the game song “Butter to sell, honey to sell” with clear pronunciation, joining in with the group (MSB learning outcome: pronounces the lyrics correctly — unverified).",
   "MHB4 Musical Movement (field skill): Walks pit-a-pat around the circle in time with the song; shows fast and slow tempo through movement (MHB learning outcome: shows differences in tempo through movement or dance — unverified).",
   "OB5 Cultural Literacy: Recognises a traditional children's game learnt from grown-ups and plays it by its rules.",
   "SDB2.2 Cooperation and D4 Friendship: Notices that a friend is sad and suggests a solution that shares being ‘it’."
  ],
  "once": [
   "Look at the children on the cover: “What do you think they're playing in the park?”",
   "Say “Butter to sell, honey to sell” together, clapping along. Ask whether anyone in your family knows this game.",
   "Child-friendly words: “Butter to sell, honey to sell, / Master's away, I sell as well… / Look behind you, look behind you!”"
  ],
  "sirasi": [
   "On page 2, sing the song as Deniz walks; one step, one “pat”, for every touch.",
   "On page 3, listen to the child's reason for their prediction; don't say right or wrong.",
   "On page 5, look at Deniz's face together: lip wobbling, shoulders drooping. Touch Deniz, Ali and Elif in turn; ask “How would you feel if you were them?”"
  ],
  "sonra": [
   "Count the order of the game on your fingers: first the song, then the hanky, then “Look behind you!”",
   "Why was Deniz sad, and what made her smile? How did Elif's idea help Deniz?",
   "Who else could be it together? Find a rule that makes the game more fun for everyone."
  ],
  "sinif": {
   "ad": "Butter to Sell in the Circle",
   "sure": "15 min",
   "materyal": "A soft, lacy hanky, a wide space (a circle wide enough for wheelchairs and walkers to pass comfortably)",
   "adim": [
    "The children make a circle on the floor or on chairs and look straight ahead.",
    "The child who is it (or two children who are it, hand in hand) walks around the outside of the circle in rhythm, singing the song; the teacher sets a slow tempo, then a fast one, with the tambourine.",
    "When the song ends, the hanky is dropped behind someone; everyone says “Look behind you!”",
    "The child who finds the hanky gets up and walks one round with the one who is it; nobody leaves the game, and being it is not a punishment (fast walking is safer than running).",
    "At the end of the game, ask: “How did you feel when you were it? What changed when two of you were it?”"
   ]
  },
  "evSoru": [
   "Why was Deniz sad?",
   "What did Elif suggest?",
   "Which old game would you like to play with your mum, your dad or your grandpa?"
  ],
  "evEtk": {
   "ad": "The Grown-Ups' Game",
   "d": "Learn a circle game or a rhyme from a grown-up at home that they played as a child. Play “Butter to sell, honey to sell” together in the living room with a hanky; sing one round slowly and one round fast."
  },
  "aileNotu": "Today we read “Butter to Sell, Honey to Sell.” Ali, Deniz and Elif played the traditional circle game they learnt from their grandparents in the park. Deniz was sad when she was always it; Elif suggested being it together. At home you can play this game with a hanky, and tell your child about the games of your own childhood."
 },
