{
 "id": "mirmir",
 "lang": "en",
 "title": "Mumble the Bear Cub Can't Sleep",
 "blurb": "A sound in the night frightens Mumble. His mum teaches him a little trick for dealing with fear.",
 "pages": [
  {
   "text": "The forest was dark. Everyone was asleep. But Mumble the bear cub's eyes were wide open.",
   "hits": {
    "bear": "“I can't sleep!”",
    "star": "A twinkly, sparkly star!"
   },
   "hint": "Touch the stars in the window!",
   "ask": "What do you do when you can't sleep?"
  },
  {
   "text": "“Hoo hoooo!” There was a sound. Mumble hid under his blanket. “What's that sound?”",
   "hits": {
    "owl": "“Hoo hoooo!”",
    "bear": "“I'm so scared…”"
   },
   "hint": "Touch the sound at the window!",
   "ask": "Let's make the “hoo hoooo” sound together. Who could be making it?"
  },
  {
   "text": "Mumble's heart went thump thump. He called out to his mum: “Mummy, I'm scared!”",
   "hits": {
    "heart": "Thump thump, thump thump…",
    "bear": "“I'm so scared…”"
   },
   "predict": {
    "q": "Whose sound do you think it is?",
    "res": "It could be either! Let's see.",
    "opts": [
     "A little owl",
     "A sweet monster"
    ]
   },
   "hint": "Touch the heart and listen to it!",
   "ask": "What happens in our bodies when we're scared? How does your heart beat?"
  },
  {
   "text": "His mum came and opened the window. “Look,” she said. There was a little owl in the tree. “Hoo hoooo, good night!”",
   "hits": {
    "owl": "“Hoo hoooo, good night, Mumble!”",
    "mom": "“I'm here, sweetheart. Don't be scared.”",
    "bear": "“I can't sleep!”"
   },
   "hint": "Touch Mama Bear!",
   "ask": "How did Mumble feel when he saw the owl?"
  },
  {
   "text": "His mum gave Mumble a hug: “It's all right to be scared. When you're scared, take a deep breath. Smell the flower through your nose, blow out the candle through your mouth.”",
   "hits": {},
   "mech": {
    "done": "“Well done, Mumble! You're calmer now.”"
   },
   "hint": "First smell the flower, then blow out the candle!",
   "ask": "Let's try it together: smell the flower… blow out the candle… Three times."
  },
  {
   "text": "Mumble smelled the flower through his nose and blew out the candle through his mouth. Then he smiled. “Good night, owl!” His eyes slowly closed. He slept snug and sound.",
   "hits": {
    "moon": "The Moon is sleeping too. Shhh…",
    "bear": "Shhh, Mumble is sleeping."
   },
   "hint": "Touch the Moon!",
   "ask": "What helps you feel calm before you go to sleep?"
  }
 ],
 "guide": {
  "kazanim": [
   "Recognises and expresses feelings (fear, relief).",
   "Uses a simple breathing strategy to cope with difficult feelings.",
   "Guesses where a sound is coming from.",
   "Works out how a story character feels from their facial expressions."
  ],
  "once": [
   "Ask: “Have you ever heard a sound at night and felt scared?”",
   "Dim the lights a little to set the scene for the story."
  ],
  "sirasi": [
   "On page 2, make the “hoo hoooo” sound together.",
   "On page 5, do the breathing game on the screen three times with the whole class."
  ],
  "sonra": [
   "When was Mumble scared, and when did he feel better?",
   "What do you do when you're scared? Who do you tell?",
   "When could we use the “smell the flower, blow out the candle” breath?"
  ],
  "sinif": {
   "ad": "Whose Sound Is It?",
   "sure": "15 min",
   "materyal": "A recording of animal sounds or the teacher's voice, feelings cards",
   "adim": [
