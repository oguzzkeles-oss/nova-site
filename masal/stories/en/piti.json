{
 "id": "piti",
 "lang": "en",
 "title": "Puffy the Cloud",
 "blurb": "A tiny cloud calls her friends to help the thirsty flowers.",
 "pages": [
  {
   "text": "Up in the sky there was a tiny cloud. Her name was Puffy. Puffy was as white as cotton wool.",
   "hits": {
    "piti": "“Hello! I'm Puffy!”",
    "sun": "“Good morning!”"
   },
   "hint": "Touch Puffy!",
   "ask": "What do clouds look like? Have you ever found shapes in the clouds?"
  },
  {
   "text": "It had not rained for days. Down below, the flowers hung their heads. “We're thirsty, so thirsty!” they said.",
   "hits": {
    "f": "“We're thirsty!”",
    "sun": "“Phew, it's so hot today!”"
   },
   "hint": "Touch the flowers!",
   "ask": "Why might the flowers be hanging their heads?"
  },
  {
   "text": "Puffy was very sad. “I'm only a tiny little cloud. What can I do?” she thought.",
   "hits": {
    "piti": "“Hmm… What can I do?”"
   },
   "predict": {
    "q": "What do you think Puffy will do?",
    "res": "Good guess! Let's turn the page and see.",
    "opts": [
     "She calls her friends",
     "She goes to sleep"
    ]
   },
   "hint": "Touch Puffy!",
   "ask": "Have you ever felt small? What did you do?"
  },
  {
   "text": "Puffy called her friends: “Come, clouds, come!” The clouds came and held hands.",
   "hits": {},
   "mech": {
    "done": "Three clouds! They held hands."
   },
   "hint": "Count the clouds: touch them one by one!",
   "ask": "How many clouds came? Let's count together."
  },
  {
   "text": "Together they grew and grew… They became one great big, dark grey cloud. And pitter patter, pitter patter, down came the rain!",
   "hits": {
    "piti": "“Hello! I'm Puffy!”"
   },
   "mech": {
    "done": "All the flowers had a drink!"
   },
   "hint": "Touch the flowers so they can drink the rain!",
   "ask": "Let's make the sound of rain with our fingers: pitter patter, pitter patter!"
  },
  {
   "text": "The flowers lifted their heads. “Thank you, Puffy!” they said. Puffy gave a great big smile: “When we work together, even little ones can do big things!”",
   "hits": {
    "rbw": "A rainbow! Red, orange, yellow, green, blue, purple.",
    "f": "“Hooray!”",
    "piti": "“Hello! I'm Puffy!”"
   },
   "hint": "Touch the rainbow!",
   "ask": "Who have you helped? Tell me about something you did together with someone."
  }
 ],
