     "say": "The sun is right overhead. Good afternoon time!"
    },
    "ali": {
     "say": "What if I get mixed up again?"
    },
    "dede": {
     "say": "Look at the sky, find the greeting!"
    },
    "nur": {
     "say": "Oh, look who I can see at the market!"
    }
   },
