 "guide": {
  "kazanim": [
   "TAEOB.3 (teyitsiz) Ses bilgisel farkındalık becerileri gösterebilme: sözcüklerin ilk seslerini fark eder; arı–Ali, zil–Zeynep, davul–Deniz gibi aynı sesle başlayan sözcükleri eşleştirir.",
   "TAOB.2 Görsel materyallerden anlamlar üretebilme: resimli sembol kartlarının kime ait olduğunu resimden ve ilk sesten çıkarır; kartı sınıftaki kendi sembolüyle, yani günlük yaşamıyla ilişkilendirir.",
   "TADB.3 Dinlediği hikâyeyi çözümleyebilme: kaybolma, arama, bulma ve geri takma olaylarını oluş sırasına göre söyler.",
   "SDB1.1 Kendini Tanıma: adını, adının ilk sesini ve kendine ait sembolü tanır; üzüntünün bedende nasıl hissedildiğini (boğazda düğüm) fark edip adlandırır, derin nefes ve yardım isteme yolunu dener.",
   "D4 Dostluk: arkadaşının sorununu fark eder, onunla birlikte çözüm arar."
  ],
  "once": [
   "Kapağı gösterin: “Ali neyi arıyor olabilir? Gerçek bir arı mı, başka bir şey mi?” diye sorun.",
   "Sınıftaki sembol kartlarınıza birlikte bakın: “Senin kartında ne var? O resim hangi sesle başlıyor?”",
   "Sesleri uzatma oyununu tanıtın: “Mmmasa, sssu.” Çocuklar ilk sesi sizinle birlikte uzatsın."
  ],
  "sirasi": [
   "1. sayfada “Eeela, eeelma” deyip ilk sesi uzatın; çocuklar sizinle birlikte uzatsın. Zeynep'i ve Deniz'i de tanıtın.",
   "2. sayfada Ali'nin duygusunu adlandırın ve birlikte bir derin nefes alın.",
   "3. sayfadaki tahmin sorusunda iki cevabı da kabul edin; kartlar iki yerde de çıkacak.",
   "5. sayfada eşleştirmeden önce “Zzzil… Zzzeynep!” diye ilk sesi uzatarak ipucu verin; D gibi uzatılamayan seslerde “d-d-davul” diye tekrarlayın. Çocuğun kendisi dokunsun."
  ],
  "sonra": [
   "Ali kartını göremeyince ne hissetti? Bedeninde ne oldu? Sonra ne yaptı?",
   "Ela kartların kime ait olduğunu nasıl buldu?",
   "Senin adın hangi sesle başlıyor? O sesle başlayan bir şey söyler misin?",
   "Masalı resimlerle sıralayalım: önce ne oldu, sonra ne oldu?"
  ],
  "sinif": {
   "ad": "Sembol Kartım",
   "sure": "20 dk",
   "materyal": "Kartonlar, boya kalemleri, bant, sınıftan çeşitli nesneler (elma, zil, top, kitap, makas vb.)",
   "adim": [
    "Çember olun. Her çocuk adını söylerken ilk sesini uzatsın: “Aaali”, “Eeela”, “Zzzeynep”.",
    "Ortaya konan nesnelerden adının ilk sesiyle başlayanı bulsun (Kerem–kitap, Mira–makas). İlk sesi zor adlar için (Ömer–örümcek, Işıl–ıspanak) birlikte fikir üretin.",
    "Her çocuk seçtiği nesnenin resmini kartına çizsin; isteyen çocuğun kartının altına adını siz yazın.",
    "Kartları dolaplara ya da askılara sıkıca yapıştırın. Ertesi sabah kartları karıştırıp “Bu kart kimin?” oyunu oynayın."
   ]
  },
  "evSoru": [
   "Ali'nin kartı kaybolunca ne hissetti? Sen olsan ne hissederdin?",
   "Ela kartları nasıl buldu? İlk sesler ona nasıl yardım etti?",
   "Senin adın hangi sesle başlıyor? Evde o sesle başlayan neler var?"
  ],
  "evEtk": {
   "ad": "Kapımdaki Resim Kartı",
   "d": "Çocuğunuzla adının ilk sesiyle başlayan bir resim seçin (Deniz–davul, Ela–elma gibi). Birlikte çizip odasının kapısına asın. Ailedeki herkes için de bir kart yapın; gün içinde “Bu resim hangi sesle başlıyor, kimin kapısı?” diye oynayın."
  },
  "aileNotu": "Bugün sınıfımızda “Ali'nin Arısı Nerede?” masalını okuduk. Masalda Ela, kaybolan resim kartlarını sözcüklerin ilk seslerini dinleyerek sahiplerine ulaştırdı: arı–Ali, zil–Zeynep, davul–Deniz. Çocuklarımızla adımızın hangi sesle başladığını konuştuk. Evde “Bu hangi sesle başlıyor?” diye sorarak günlük nesnelerle ses avı yapabilir, harf adları yerine sesleri uzatarak (mmmasa) söyleyebilirsiniz."
 },
