   "Tekerleme ve şarkı dinlemeyi seçer, dinler (TADB.1)",
   "Dinlediği hikâyedeki olayları oluş sırasına göre anlatır (TADB.3)",
   "Bir arkadaşıyla birlikte ortak bir ürün (şarkı) oluşturur (SDB2.2 İş Birliği)"
  ],
  "once": [
   "Kapağı gösterip sorun: Kedi, kirpi ve arı ne yapıyor olabilir?",
   "Oyun: Adımı söyleyeceğim, sonu benzeyen bir sözcük bulalım (Ayşe–kayşe).",
   "Uyak, günlük dilde ‘kafiye’ diye de bilinir."
  ],
  "sirasi": [
   "2. sayfada şarkının neden tökezlediğini sorun.",
   "Eşleştirme sayfalarında (4 ve 5) çocuk dokunmadan önce resimlerin adını birlikte söyleyin; sesli karşılık yalnız doğru eşten sonra gelir."
  ],
  "sonra": [
   "Şarkıyı el çırparak birlikte söyleyin.",
   "Olayları sıralayın: şarkı olmadı → Vızvız geldi → uyak avı → şarkı.",
   "Uydurma uyaklarla oyun oynayın (E2.5 Oyunseverlik)."
  ],
  "sinif": {
   "ad": "Uyak Sepeti",
   "sure": "15 dk",
   "materyal": "Sepet; karpuz, muz, portakal, bal, çiçek, böcek resim kartları (yazısız) ve 2 kartı eşsiz çeldirici (ör. elma, top)",
   "adim": [
    "Kartları sepetten tek tek çıkarıp adını söyleyin.",
    "Çocuklar sonu benzeyen eşi bulup kartı yanına koysun.",
    "Bulunan eşlerle sınıfça iki dizelik bir şarkı uydurun."
   ]
  },
  "evSoru": [
   "Şarkı ilk seferde neden olmadı?",
   "Adınla uyaklı komik bir sözcük var mı?",
   "Arkadaşınla birlikte bir şey yaptığında ne hissettin?"
  ],
  "evEtk": {
   "ad": "Mutfakta uyak avı",
   "d": "Mutfakta sonu benzeyen eşleri birlikte bulun: tabak–kabak, tencere–pencere, çatal–masal. Uydurma sözcükler de serbest!"
  },
  "aileNotu": "Bugün Uyak Avı masalını okuduk. Karamel ile Kıpır, sonları benzeyen sözcükleri (karpuz–muz, çiçek–böcek) bularak birlikte bir şarkı yazdı. Evde oyun gibi uyak avına çıkabilirsiniz. Anlamsız ama uyaklı sözcükler de bu yaşta ses farkındalığını destekler."
 },
