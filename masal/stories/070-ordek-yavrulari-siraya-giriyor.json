 "guide": {
  "kazanim": [
   "MAB.1 Ritmik ve algısal sayabilme: 1-20 arasındaki nesne/varlık miktarını sayarak belirler; çocuk suya giren yavruları tek tek dokunarak sayar ve kaç tane olduklarını söyler.",
   "MAB.1.f (teyitsiz alt çıktı) Nesne veya kişilerin sırasını sıra sayı sözcükleriyle belirtir; birinci, ikinci, üçüncü, dördüncü, beşinci yavruyu sırayla gösterir ve yön değişince sıranın da değiştiğini fark eder.",
   "TADB.3 Dinledikleri materyalleri çözümleyebilme: olayların parçalarını belirler, dinlediklerini oluş sırasına göre söyler (masal sonu sıralama oyunu).",
   "E3.2 Odaklanma: sıra oyununda ve saymada dikkatini sonuna kadar sürdürür.",
   "SDB3.1 Uyum ve D12 Sabır: grup içinde sırasını bekler; beklerken nefes alma ve sayma gibi bir sakinleşme yolu kullanır ve bu yolu arkadaşıyla paylaşır."
  ],
  "once": [
   "Kapaktaki ördeklere bakın: “Kaç yavru var? Sence nereye gidiyorlar?”",
   "“Sıra” sözcüğünü konuşun: “Sen nerelerde sıra beklersin? Kaydırakta, lavaboda…”"
  ],
  "sirasi": [
   "Yavruların çarpıştığı sayfada durun: “Hepsi birden koşunca ne oldu?”",
   "Sıra sayfasında birinci, ikinci… derken parmağınızla gösterin; çocuk da sizinle söylesin.",
   "Pıtpıt beklerken birlikte derin nefes alıp dörde kadar sayın."
  ],
  "sonra": [
   "“Pıtpıt önce en sondaydı, sonra nasıl birinci oldu?” diye sorun; yön değişince sıranın değiştiğini oyuncaklarla gösterin.",
   "Masalın üç sahnesini oluş sırasına göre anlatmasını isteyin: çarpışma, sıraya girme, eve dönüş.",
   "“Beklemek bazen zor. Sen beklerken ne yapabilirsin?” diye konuşun; nefes alma ve sayma yollarını hatırlatın."
  ],
  "sinif": {
   "ad": "Ördek Treni",
   "sure": "15 dk",
   "materyal": "Yere yapıştırılmış mavi bant ya da kumaş (göl), beş ördek maskesi ya da sarı yaka kartı, rakamlı ve noktalı 1-5 sayı kartları",
   "adim": [
    "Beş çocuk ördek olur, sayı kartlarını alır ve “göl”e doğru arka arkaya dizilir; sınıf birlikte “birinci, ikinci… beşinci” der.",
    "Öğretmen “Şıp!” dedikçe sıradaki ördek göle süzülür; bekleyenler nefes alıp suya girenleri sayar.",
    "Öğretmen “Eve dönüyoruz!” deyince ördekler geri döner; sınıf yeni birinciyi ve yeni beşinciyi söyler.",
    "Roller değiştirilerek her çocuğun hem birinci hem sonuncu olması sağlanır; “Beklerken ne hissettin?” diye konuşulur."
   ]
  },
  "evSoru": [
   "Ördek yavruları neden kıyıda yuvarlandı?",
   "Pıtpıt beklerken ne yaptı? Sonra bu oyunu kime öğretti?",
   "Eve dönerken kim birinci oldu? Neden?"
  ],
  "evEtk": {
   "ad": "Evde sıra oyunu",
   "d": "Beş oyuncağı ya da çorabı arka arkaya dizin. Çocuk “Birinci hangisi? Üçüncü hangisi?” sorularını parmağıyla göstererek yanıtlasın. Sonra sırayı ters çevirin ve yeni birinciyi birlikte bulun."
  },
  "aileNotu": "Bugün “Ördek Yavruları Sıraya Giriyor” masalını okuduk. Beş ördek yavrusu göle aynı anda girmeye çalışınca çarpıştılar; kurbağa Vrak'ın sıra oyunuyla birinci, ikinci, üçüncü diye sıraya girdiler. En sondaki Pıtpıt beklerken derin nefes aldı ve suya girenleri saydı; dönüşte en öne geçince bu yolu en sondaki kardeşine öğretti. Evde sofraya ya da banyoya giderken “Kim birinci, kim ikinci?” oyununu oynayabilir, bekleme anlarında birlikte nefes alıp sayabilirsiniz."
 },
