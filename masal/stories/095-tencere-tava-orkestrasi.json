 "guide": {
  "kazanim": [
   "MÇB3 Müziksel Çalma (alan becerisi) · MÇB öğrenme çıktısı “Duyduğu sesleri ve müzik eserlerini çalabilme”: Dedenin çaldığı “tak, çın, tın” ritmini dinler ve kâse-tabak-bardakla aynı sırayla tekrar eder; hızlı ve yavaş tempo farklılıklarına vurmalı (mutfak) çalgılarla eşlik eder.",
   "MYB5 Müziksel Yaratıcılık (alan becerisi) · MYB öğrenme çıktısı “Müziksel deneyimlerine dayalı müziksel ürünler oluşturabilme ve bunları sergileme”: Mutfak eşyalarıyla kendi yavaş ya da hızlı ritmini uydurur ve arkadaşlarına çalarak sergiler.",
   "E3.3 Yaratıcılık ve D11 Özgürlük: Sıradan eşyalardan çalgı yaratır; kendi ritmini seçme özgürlüğünü kullanırken başkalarının da sesini duyurma hakkını fark eder.",
   "SDB2.2 İş Birliği: Birlikte çalarken sırayla çalma fikrini kendileri bulur, birbirini dinler; önce dinleyip sonra tekrar ederek ortak bir ritim kurar."
  ],
  "once": [
   "Mutfakta ses çıkaran eşyaları birlikte sayın: Bunlarla müzik yapılabilir mi?",
   "Masaya vurmadan önce dizlerinize yavaşça, sonra hızlıca vurun; farkı birlikte adlandırın: yavaş, hızlı."
  ],
  "sirasi": [
   "2. sayfada çalgıları sayarken her birinin sesini ağızla taklit edin: tak, çın, tın.",
   "3. sayfada gürültünün bedende nasıl hissettirdiğini sorun; tahmin sorusunda her cevabı kabul edin.",
   "4. sayfada Dede'yle birlikte nefes alın (burundan al, ağızdan fuuu), sonra ritmi ekranda ve ellerinizle tekrar edin.",
   "5. sayfada Zeynep'in yavaş, Ali'nin hızlı ritmini sırayla çalın; sırayla çalma fikrini kimin bulduğunu sorun."
  ],
  "sonra": [
   "Ali ile Zeynep neden bunaldı? Ne yapınca rahatladılar?",
   "Yankı oyunu kimin fikriydi? Sırayla çalmayı kim önerdi? Neden işe yaradı?",
   "Olayları resimlerle sıralayın: ikisi birden çaldı → nefes aldılar → sırayla çaldılar."
  ],
  "sinif": {
   "ad": "Mutfak Orkestrası Yankı Oyunu",
   "sure": "20 dk",
   "materyal": "Plastik ya da metal kâseler, kırılmaz tabaklar, tahta ve metal kaşıklar, plastik şişe içinde kuru bakliyat (sıkıca kapalı)",
   "adim": [
    "Çocuklar çember olur; her çocuk bir mutfak eşyası ve bir kaşık seçer. Kırılabilir cam ve porselen kullanılmaz.",
    "Sese duyarlı çocuklar için ‘fısıltı ritmi’ (parmak uçlarıyla) seçeneği sunun; isteyen çocuk dinleyici/şef olabilir.",
    "Öğretmen üç vuruşluk kısa bir ritim çalar (ör. tak-tak-çın); çocuklar önce dinler, sonra hep birlikte tekrar eder.",
    "Sırayla her çocuk kendi yavaş ya da hızlı ritmini uydurur; grup “yankı” olup tekrar eder.",
    "Bir tur herkes aynı anda çalar; sonra “Hangisinde ritimleri duyabildik?” diye konuşulur.",
    "Kapanışta tüm sınıf aynı ritimle yavaş başlayıp hızlanır, sonra fısıltı gibi yavaşlayıp durur."
   ]
  },
  "evSoru": [
   "Dede mutfakta hangi eşyalarla orkestra kurdu?",
   "Ali ile Zeynep bunalınca ne yaptı?",
   "Sen hangi ritmi uydurmak isterdin? Bana çal, ben tekrar edeyim!"
  ],
  "evEtk": {
   "ad": "Evde Yankı Orkestrası",
   "d": "Mutfaktan kırılmaz iki eşya (plastik kâse, tahta kaşık, tencere kapağı) seçin. Sırayla kısa ritimler uydurup birbirinizi yankı gibi tekrar edin; bir yavaş, bir hızlı çalın. Bitince eşyaları birlikte yerine koyun. Evde cam bardak yerine çelik ya da plastik bardak kullanın."
  },
  "aileNotu": "Bugün “Kaşık Kâse Orkestrası” masalını okuduk. Dede yağmurlu bir günde mutfakta çorba pişirirken torunlarıyla çelik kâse, kırılmaz tabak ve kaşıklardan bir orkestra kurdu. Çocuklar kendi ritimlerini uydurdu; ikisi birden çalınca bunaldılar, nefes aldılar; sonra yankı oyununu ve sırayla çalmayı kendileri önerdiler. Evde kırılmaz mutfak eşyalarıyla “dinle ve tekrar et” oyununu oynayabilirsiniz."
 },
