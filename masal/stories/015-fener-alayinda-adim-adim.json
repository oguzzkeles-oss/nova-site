 "guide": {
  "kazanim": [
   "OB6 Vatandaşlık Okuryazarlığı: Cumhuriyet Bayramı'nın toplumca birlikte kutlanan bir gün olduğunu fark eder; mahallesindeki bayram etkinliğinde görev alır.",
   "HSAB.6 Eşle/grupla ahenk içinde hareket örüntüleri sergileyebilme: davulun ritmine uyarak arkadaşıyla el ele, adım adım yürür (\"Güm, bir! Güm, iki! Güm, üç! Güm, dört!\").",
   "TADB.3 Dinlediklerini/izlediklerini çözümleyebilme: masalın olaylarını (fenerleri yakma, geride kalma, el ele yürüme) oluş sırasına göre söyler.",
   "SDB2.2 İş Birliği ve E2.2 Sorumluluk: fener sorumlusu olur, arkadaşı geride kalınca elini uzatır; D19 Vatanseverlik ve D16 Sorumluluk değerlerini günlük bir bayram deneyiminde yaşar."
  ],
  "once": [
   "Takvimde 29 Ekim'i gösterin: “Bugün Cumhuriyet'in doğum günü. Cumhuriyetimizi Atatürk kurdu.”",
   "Kapağa bakın: “Bu çocuklar neye hazırlanıyor olabilir? Sokakta neler görüyorsun?”",
   "Masaya ya da tefe vurarak “güm, güm” ritmi yapın; çocuk yerinde adım saysın."
  ],
  "sirasi": [
   "2. sayfada fenerleri çocuğun yakmasını bekleyin: “Sen de fener sorumlususun!” deyin. Fenerlerin pilli olduğunu vurgulayın; gerçek alev yok.",
   "3. sayfada Can'a dokunun, “Kalbim küt küt!” desin. “Telaşlanınca kalbimiz nasıl atar?” diye sorun. Tahmin sorusunda iki seçeneği de övün; ikisi de işe yarar.",
   "4. sayfada her dokunuşta birlikte “Güm, bir! Güm, iki! Güm, üç! Güm, dört!” deyin ve dizlerinize vurun.",
   "5. sayfada önce davula, sonra Zeynep'e, sonra Can'a dokunun; “Bir adım sen, bir adım ben!” tekerlemesini karşılıklı söyleyin. Arka kaldırımdaki komşuların fenerlerini gösterin."
  ],
  "sonra": [
   "Can neden telaşlandı? Telaşlanınca bedeninde ne oldu? (Kalbi küt küt attı.) Ona ne iyi geldi?",
   "Zeynep hangi fikri buldu? Sen olsan geride kalan bir arkadaşına ne yapardın?",
   "Fener alayı bir bayram geleneği. Aileler bayramı nasıl kutlar? Resimli kartlarla (bayrak asma, fener alayı, bayram ziyareti) eşleştirin; çocuk kendi ailesinin geleneğini anlatsın."
  ],
  "sinif": {
   "ad": "Sınıf Fener Alayı",
   "sure": "20 dk",
   "materyal": "Renkli kâğıt, yapıştırıcı, çubuk, pilli LED mum (gerçek mum ve kibrit yok), küçük kâğıt bayraklar, tef ya da davul",
   "adim": [
    "Kâğıttan fener yapın; içine pilli LED mumu öğretmen yerleştirsin.",
    "Her çocuk fenerinin düğmesine basıp “fener sorumlusu” olsun.",
    "Tef ritmiyle ikişerli el ele yürüyün: “Güm, bir! Güm, iki!”",
    "Ritmi yavaşlatıp hızlandırın; eşler adımlarını birbirine uydursun, geride kalan eşini beklesin.",
    "Bayrağın önünde halka olun, “İyi ki doğdun Cumhuriyet!” deyin ve kimin nasıl hissettiğini paylaşın."
   ]
  },
  "evSoru": [
   "Fenerleri kim yaktı? Nasıl yaktılar?",
   "Can geride kalınca ne hissetti? Ona kim yardım etti?",
   "Zeynep ile Can adımlarını nasıl birleştirdi?"
  ],
  "evEtk": {
   "ad": "Evde fener alayı",
   "d": "Bir kâğıt ya da kavanozdan fener yapın, içine pilli LED ışık koyun. Evin koridorunda el ele, bir tencere “davulun” ritmine uyarak yürüyün: “Bir adım sen, bir adım ben!” Sonra ailenizin bayram geleneklerini anlatın."
  },
  "aileNotu": "Bugün “Fener Alayında Adım Adım” masalını okuduk. Zeynep ile Can, Cumhuriyet Bayramı'nda fener sorumlusu oldu; Can alayda geride kalınca telaşlandı, Zeynep'in uzattığı el ve davulun ritmiyle yeniden adımlarını buldu. Evde 29 Ekim'i ve ailenizin bayram geleneklerini birlikte konuşabilirsiniz. Fener yaparsanız lütfen gerçek mum yerine pilli ışık kullanın."
 },
