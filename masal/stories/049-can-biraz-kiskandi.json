 "guide": {
  "kazanim": [
   "TADB.2 — Dinlediği hikâyeyle ilgili yeni anlamlar oluşturur: materyale ilişkin çıkarım yapar (“Ela neden birden sustu?”) ve hikâyedeki bilgilerle günlük hayatı arasında ilişki kurar (“Ben ne zaman kıskandım?”).",
   "SDB1.2 Kendini Düzenleme — Kıskançlığın bedendeki işaretlerini (karında düğüm, sıkışan boğaz, ısınan yanaklar) fark eder, duyguya ad verir ve nefes alarak sakinleşmeyi dener.",
   "beceri: SBAB5 Sosyal Katılım — Yeni gelen bir çocuğu oyuna katar; üç kişilik ortak bir oyun kurar ve kurala uyar (“Topu atan, tutanın adını söyler”).",
   "E2.1 Empati — Hem dışarıda kalan Ela'nın hem de parka yeni gelen Elif'in ne hissettiğini düşünür.",
   "D4 Dostluk — Bir arkadaşlığın yeni arkadaşlarla küçülmediğini, oyunla büyüdüğünü deneyimler."
  ],
  "once": [
   "Kapaktaki üç kızı gösterin: “Sence bunlar arkadaş mı? Nereden anladın?”",
   "“Kıskanmak ne demek?” diye sorun; her cevabı kabul edin, düzeltmeyin."
  ],
  "sirasi": [
   "2. sayfada Ela'nın uzaktan bakışına dikkat çekin: “Ela'nın yüzü ne söylüyor?”",
   "3. sayfada Ela'nın kalbine dokunun; kıskanınca bedende neler olduğunu (karın, boğaz, yanaklar) konuşun. “Bu duygu neydi?” sorusunu çocuklara bırakın. Tahminde iki cevabı da kabul edin; ikisi de iyi yol.",
   "4. sayfada nefes oyununu birlikte üç kez yapın: burundan çiçeği kokla, ağızdan mumu üfle.",
   "6. sayfada topu sırayla Zeynep'e, Elif'e, Ela'ya atın; her atışta adı yüksek sesle söyleyin."
  ],
  "sonra": [
   "Ela ne zaman kıskandı? Kıskanınca ne yaptı?",
   "Ela, Zeynep'e ne dedi? Zeynep ne cevap verdi?",
   "Top çemberi oyununu kim buldu? Sen olsan nasıl bir oyun bulurdun?",
   "Parka ilk gelen Elif ne hissetmiş olabilir?"
  ],
  "sinif": {
   "ad": "Top Çemberi",
   "sure": "20 dk",
   "materyal": "Yumuşak bir top, yere çember çizmek için tebeşir ya da ip, duygu yüz kartları",
   "adim": [
    "Çocuklarla çember olun. Kıskanç, üzgün ve sakin yüz kartlarını gösterin; “Bu yüz ne hissediyor?” diye sorun.",
    "Çocuklar ellerini kıskançlığı hissettikleri yere koysun (karın, boğaz, yanak) ve “Benim düğümüm burada” desinler.",
    "Hep birlikte üç kez “çiçeği kokla, mumu üfle” nefesini yapın ve “düğümü çözün”; düğüm şimdi nasıl, sorun.",
    "Elif'in kuralıyla top çemberi oynayın: topu atan, tutanın adını söyler. Herkes en az bir kez topu tutsun; oturarak oynayan arkadaşlar için topu yuvarlayın."
   ]
  },
  "evSoru": [
   "Ela'nın karnındaki düğüm neydi?",
   "Ela düğümü nasıl çözdü?",
   "Sen bir arkadaşını kıskandığında ne yapabilirsin?"
  ],
  "evEtk": {
   "ad": "Adını söyle, topu at",
   "d": "Evde yumuşak bir top ya da çorap topuyla aile çemberi kurun. Topu atan, tutanın adını söylesin. Oyuna bir oyuncak ayıyı da “yeni arkadaş” olarak katın ve ona da sıra verin."
  },
  "aileNotu": "Bugün “Ela Biraz Kıskandı” masalını okuduk. Ela, en yakın arkadaşı Zeynep yeni gelen Elif'le oynayınca kıskanıyor; duygusuna ad veriyor, annesiyle nefes alıyor ve Zeynep'e “Biraz kıskandım” diyor. Kıskançlık her çocuğun yaşadığı doğal bir duygudur; evde “Kıskandın galiba, olur” diyerek duyguyu kabul edebilir, sonra birlikte bir çözüm arayabilirsiniz. Nefes oyununu gerçek mum yakmadan, parmağınızı mum yaparak deneyebilirsiniz."
 },
