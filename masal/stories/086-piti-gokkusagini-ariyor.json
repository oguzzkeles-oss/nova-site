 "guide": {
  "kazanim": [
   "SNAB.2 Sanat eseri inceleyebilme: Çocuk gökkuşağını, çayırdaki renkleri ve sınıfta gösterilen bir ebru ya da resmi inceler; “En çok hangisini beğendin, neden?” sorusuyla duygu ve düşüncelerini ifade eder (SNAB.2.g).",
   "TAOB.2 Görsel materyallerden anlamlar üretebilme: Resimlerden kırmızının nerede saklandığını tahmin eder, gördüklerini kendi çevresindeki renklerle ilişkilendirir.",
   "TADB.2 Dinlediği hikâyeyle ilgili yeni anlamlar oluşturabilme: Pıtı'nın neden üzüldüğüne ve sonunda neden sevindiğine ilişkin çıkarım yapar.",
   "SDB1.1 Kendini Tanıma ve D7 Estetik: Kendi en sevdiği rengi söyler, güzel bulduğu şeyleri fark eder ve adlandırır."
  ],
  "once": [
   "Kapaktaki Pıtı'yı göster: “Bu bulut neyi arıyor olabilir?”",
   "Pencereden bakın: “Şu an dışarıda hangi renkleri görüyoruz?”",
   "Masalda gökkuşağını güneşin getirdiğini, renk avının ise güneşi beklerken oynanan bir oyun olduğunu söyleyin."
  ],
  "sirasi": [
   "2. sayfada Pıtı'nın yüzünü gösterin: “Nasıl hissediyor? Neden?”",
   "3. sayfada tahmin sorusunda iki cevabı da kabul edin; sonra birlikte görün.",
   "4. sayfada kırmızıları bulurken rengin adını hep birlikte söyleyin; 5. sayfada her çiçeğe dokunurken rengini söyleyin.",
   "Son sayfada gökkuşağının renklerini parmakla gösterip sırayla adlandırın."
  ],
  "sonra": [
   "Pıtı neden üzüldü? Gökkuşağı neden çıkmıyordu? Kim ona yardım etti?",
   "Hangi renkleri buldular? Sen hangisini güzel buldun, neden?",
   "Gerçek gökkuşağını ne zaman görebiliriz? (Yağmurdan sonra güneş çıkınca; masalda da gökkuşağı güneş uyanınca çıktı.)",
   "Masalı üç resimle sıralayın: Pıtı üzgün, kırmızılar bulundu, gökkuşağı çıktı."
  ],
  "sinif": {
   "ad": "Renk Avı ve Gökkuşağı Duvarı",
   "sure": "20 dk",
   "materyal": "Kırmızı, sarı, mavi, yeşil, turuncu, mor renkte kâğıt şeritler; sınıftaki güvenli nesneler; büyük kâğıt ve pastel boyalar; bir ebru kâğıdı ya da renkli bir resim (basılı ya da ekranda)",
   "adim": [
    "Bir ebru kâğıdı ya da gökkuşağı renkli bir resim gösterin: “Bu resimde hangi renkleri görüyorsun? Sana ne hissettirdi?” Her cevabı kabul edin.",
    "Her çocuğa bir renk şeridi verin. “Pırpır gibi renk avına çıkalım!” deyin; çocuklar sınıfta o renkte bir nesne bulup getirsin.",
    "Bulunan nesneleri renklerine göre yere, gökkuşağı gibi yay biçiminde dizin ve her rengin adını birlikte söyleyin.",
    "Dizilen “gökkuşağı eserine” birlikte bakın: “En çok hangi yeri beğendin? Sana ne hissettirdi?” Her çocuk en sevdiği rengi söyleyip büyük kâğıda bir çizgi eklesin."
   ]
  },
  "evSoru": [
   "Pıtı gökkuşağını bulunca ne hissetti?",
   "Kırmızıları nerede buldular?",
   "Senin en sevdiğin renk hangisi? Evimizde o renkte neler var?"
  ],
  "evEtk": {
   "ad": "Evde renk avı",
   "d": "Bir renk seçin ve evde ya da yürüyüşte o renkte üç şey bulun. Yağmurdan sonra güneş çıkınca gökyüzüne birlikte bakın, gökkuşağı görürseniz renklerini adlandırın."
  },
  "aileNotu": "Bugün “Pıtı Gökkuşağını Arıyor” masalını okuduk. Pıtı Bulut ile kelebek Pırpır, güneşi beklerken çayırda renk avı oyunu oynadı; güneş uyanınca gökkuşağı çıktı. Gerçek gökkuşağı da yağmur damlalarına güneş vurunca oluşur. Evde birlikte bir renk seçip o renkte üç şey bulabilir, çocuğunuza en sevdiği rengi ve nedenini sorabilirsiniz."
 },
