 "guide": {
  "kazanim": [
   "HSAB.2 Farklı ebat ve özellikteki nesneleri etkin bir şekilde kullanabilme: Mont, çizme, bere ve eldiven gibi farklı büyüklükteki giysileri kavrar ve kullanır (HSAB.2.a, HSAB.2.c); eldivenle tutmanın neden zorlaştığını fark eder.",
   "TADB.3 Dinlediklerini oluş sırasına göre söyler: Giyinme adımlarını masaldaki sırayla (önce mont, sonra çizme, sonra bere, en son eldiven) uygular ve anlatır.",
   "MAB.1 Ritmik ve algısal sayabilme: 1-5 arasındaki nesnelerin miktarını söyler (kanepedeki üç bere).",
   "SDB1.1 Kendini Tanıma (Öz Farkındalık): Bunalma ve kızgınlık duygusunu adlandırır, bedende nasıl hissedildiğini (yanakların ısınması, ayakları yere vurma) fark eder.",
   "SDB1.2 Kendini Düzenleme (Öz Düzenleme): Zorlandığında derin nefes alarak sakinleşir, sonra sorunu çözmek için yeniden dener.",
   "E1.2 Bağımsızlık ve E1.5 Kendine Güvenme (Öz Güven): Giyinmeyi kendi başına dener, zorlanınca yeniden dener ve başardığında kendiyle gurur duyar. D11 Özgürlük: Kendi beresini kendisi seçer; seçiminin saygı gördüğünü yaşar."
  ],
  "once": [
   "İlk sayfadaki pencereyi gösterin: “Dışarıda ne oluyor? Karda dışarı çıkmak için neler giyeriz?”",
   "Gerçek bir eldiven getirin. Çocuk eldivenle bir kalemi ya da bir fermuarı tutmayı denesin: “Kolay mı, zor mu?”",
   "“Kendim yaparım!” dediğiniz bir şeyi paylaşın; çocuk da kendi başına yapabildiği bir şeyi söylesin."
  ],
  "sirasi": [
   "1. sayfada “Hop hop!” derken birlikte zıplayın.",
   "2. sayfada “Parmaklarım nerede?” diye sorun; çocuk parmaklarını yumruk yapıp saklasın, sonra açsın.",
   "3. sayfada Ali'nin kızgın yüzünü birlikte taklit edin, sonra “Hıııh, puuuf” diye iki kez nefes alın. Tahmin sorusunu çocuğa bırakın; iki seçenek de doğru.",
   "5. sayfada sırayı çocuğa söyletin: “Önce…, sonra…, en son…”"
  ],
  "sonra": [
   "Ali neden çizmeyi ve fermuarı tutamadı? Sorunu nasıl çözdü?",
   "Ali kızınca bedeninde ne oldu? Sakinleşmek için ne yaptı?",
   "Ali hangi bereyi seçti? Sen hangisini seçerdin?"
  ],
  "sinif": {
   "ad": "Giyinme Treni",
   "sure": "20 dk",
   "materyal": "Çocukların kendi montları, çizmeleri (botları), bere ve eldivenleri; giysi resimli sıra kartları (yazısız); bir sepet",
   "adim": [
    "Çocuklar eldiven takıp bir bereyi almayı ya da fermuar çekmeyi denesin; ne olduğunu anlatsınlar.",
    "Resimli kartları masaldaki sırayla dizin: önce mont, sonra çizme, sonra bere, en son eldiven.",
    "“Giyinme Treni” oyunu: Çocuklar sıra olur. Her biri kartlardaki sırayla bir giysiyi giyer, “Çuf çuf, sıra sende!” der ve sırayı arkadaşına verir.",
    "Zorlanan çocuğa önce “Nasıl denedin?” diye sorun, sonra “Yardım ister misin?” deyin. Treni bitiren herkes “Kendim giyindim!” diye bir zafer pozu versin."
   ]
  },
  "evSoru": [
   "Sen kendi başına neleri giyebiliyorsun?",
   "Giyinirken en çok neyi zor buluyorsun? Nasıl kolaylaşır?",
   "Ali kızınca nasıl sakinleşti? Sen de dener misin?"
  ],
  "evEtk": {
   "ad": "Kendim Seçtim, Kendim Giydim",
   "d": "Akşamdan ertesi günün giysileri için çocuğunuza iki seçenek sunun, son kararı ona bırakın. Seçtiği giysileri giyiliş sırasına göre yere dizin. Sabah çocuğunuz sırayı kendisi izlesin; siz yalnızca “Sıradaki ne?” diye sorun. Dışarı çıkarken eldivenin en sona kaldığını birlikte hatırlayın."
  },
  "aileNotu": "Bugün “Kendim Giyinirim!” masalını okuduk. Ali karda dışarı çıkmak için kendi başına giyinmek istedi; eldivenleri en başta takınca hiçbir şeyi tutamadı, kızdı, derin nefes aldı ve sırayı kendisi buldu. Bu yaşta çocuklar giyinmeyi deneyerek öğrenir; yavaş geçen bir sabah bu öğrenmenin parçasıdır. Evde iki seçenek sunup seçimi çocuğunuza bırakın, sabırla bekleyin ve çabasını fark edin: “Sırayı kendin buldun!”"
 },
