 "guide": {
  "kazanim": [
   "TAKB.1 Konuşma sürecini yönetebilme (öğrenme çıktısı); süreç bileşenleri: söz sırasını bekler, konuşana göz teması kurar, ilgi alanına giren bir konuda (hafta sonu haberi) konuşur.",
   "TADB.3 Dinlediklerini/izlediklerini çözümleyebilme (öğrenme çıktısı); süreç bileşenleri: olayların parçalarını belirler, dinlediklerini oluş sırasına göre söyler (taş Ali'den Ela'ya, Ela'dan Deniz'e geçer).",
   "E2.4 Güven ve SDB2.1 İletişim: Dinlendiğini hissedince kendini ifade etmeye cesaret eder; konuşanı sözünü kesmeden dinler.",
   "D14 Saygı ve D12 Sabır: Arkadaşının sözünü kesmez, sırasını bekler; beklerken nefes almak gibi bir yol kullanır."
  ],
  "once": [
   "Kapağı göster: “Bu çocuklar ne yapıyor olabilir? Masalın adı bir soru: Söz sırası kimde?”",
   "Küçük, pürüzsüz bir nesne hazırla (taş, top ya da kaşık). Masaldan sonra konuşma taşı olarak kullanacaksın.",
   "“Herkes aynı anda konuşursa ne olur?” diye sor, cevapları dinle."
  ],
  "sirasi": [
   "2. sayfada iki cümleyi önce hep bir ağızdan, sonra tek tek söyleyin. Farkı konuşun.",
   "3. sayfadaki tahmin sorusunda iki cevabı da kabul et; “Neden öyle düşündün?” diye sor.",
   "4. sayfada taşı ekranda sırayla dolaştırın. Yanlış kişiye dokunulunca “Söz sırası kimde?” diye sorun.",
   "5. sayfada herkes bir an sussun; saatin tik takını ya da dışarıdaki sesleri dinleyin."
  ],
  "sonra": [
   "Herkes aynı anda konuşunca ne oldu? Konuşma taşı gelince ne değişti?",
   "Ela beklerken ne yaptı? Sen beklemek zor gelince ne yaparsın?",
   "Deniz herkes onu dinleyince nasıl hissetti? Sen dinlendiğinde ne hissedersin?",
   "Masalı resimlerle sıralayın: gürültü, konuşma taşı, Deniz'in fısıltısı."
  ],
  "sinif": {
   "ad": "Konuşma Taşı Çemberi ve Kulaktan Kulağa",
   "sure": "20 dk",
   "materyal": "Konuşma taşı olarak pürüzsüz bir taş ya da küçük bir top, kâğıt, boya kalemleri",
   "adim": [
    "Çember olun. Taşı tutan hafta sonu haberini anlatsın, ötekiler gözleri ve kulaklarıyla dinlesin.",
    "Taş elden ele dolaşsın. Anlatmak istemeyen “Pas” deyip taşı yanındakine verebilir.",
    "Geleneksel “Kulaktan Kulağa” oyununu oynayın: Deniz'in fısıltısı gibi kısa bir cümleyi sırayla fısıldayın. Oyunun sonunda cümle değiştiyse gülün ve sorun: “Taşla sırayla konuşunca Deniz'in haberi neden doğru duyuldu?”",
    "Her çocuk haberinin resmini yapsın; resimler panoya asılınca sırayla anlatılsın."
   ]
  },
  "evSoru": [
   "Deniz'in minicik haberi neydi?",
   "Herkes aynı anda konuşunca ne oluyor?",
   "Bizim evde söz sırasını nasıl bekleyebiliriz?"
  ],
  "evEtk": {
   "ad": "Sofrada konuşma kaşığı",
   "d": "Akşam yemeğinde bir kaşığı “konuşma kaşığı” yapın. Kaşığı tutan gününü anlatsın, ötekiler dinlesin, sonra kaşık yanındakine geçsin. Bekleyen için “Burnundan nefes al, sıranı bekle” oyununu birlikte oynayın."
  },
  "aileNotu": "Bugün “Söz Sırası Kimde?” masalını okuduk. Herkes aynı anda konuşunca kimsenin duyulmadığını, bir konuşma taşıyla sırayla konuşunca en minik sesin bile duyulduğunu gördük. Evde sofrada bir “konuşma kaşığı” ile sırayla konuşmayı deneyebilirsiniz. Sessiz çocukları konuşmaya zorlamayın; dinlendiğini hissetmek onlara cesaret verir."
 },
