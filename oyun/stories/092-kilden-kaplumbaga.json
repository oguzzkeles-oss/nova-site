  ],
  "sonra": [
   "“Ali ilk seferde ne yaptı, ikinci seferde ne yaptı?” diye karşılaştırın.",
   "“Kaplumbağalar acele etmez” sözünü hatırlayın: Siz hangi işi yavaş yavaş yaparsınız?",
   "Nur Öğretmen'in “Henüz yapamıyorsun” sözünü hatırlayın; yapamadığınız bir şey için “henüz” demeyi birlikte deneyin."
  ],
  "sinif": {
   "ad": "Kilden Kaplumbağa Atölyesi",
   "sure": "20 dk",
   "materyal": "Kil ya da oyun hamuru, kaplumbağa resmi, ıslak bez, küçük tahta altlıklar",
   "adim": [
    "Kaplumbağa resmine birlikte bakın: kabuk, kafa, dört bacak nerede?",
    "Çocuklar “yuvarla, bastır” diyerek kabuğu ve kafayı yapar.",
    "Bacakları tek tek, “bastır, bekle, yapıştı” diyerek takarlar; birlikte dörde kadar sayılır.",
    "Kabuğa parmakla desen çizilir; dağılan olursa “Yavaş yavaş, yeniden” denir.",
    "Kaplumbağalar bir rafta sergilenir; her çocuk kendi yapım yolunu bir cümleyle anlatır."
   ]
  },
  "evSoru": [
   "Ali'nin kaplumbağası neden dağıldı?",
   "Nur Öğretmen Ali'ye ne dedi?",
   "Sen hangi işi yavaş yavaş yaparsın?"
  ],
  "evEtk": {
   "ad": "Mutfakta Hamur Kaplumbağa",
   "d": "Un, su ve biraz tuzla yumuşak bir hamur yoğurun. Çocuğunuzla birlikte bir kabuk, bir kafa ve dört bacak yapın. Acele etmeden, parçaları tek tek bastırarak birleştirin ve bacakları birlikte sayın. Hamuru ağza almaması için yanında olun; bitince elleri birlikte yıkayın."
  },
  "aileNotu": "Bugün “Kilden Kaplumbağa” masalını okuduk. Ali aceleyle yaptığı kaplumbağa dağılınca üzüldü, sonra derin bir nefes alıp yavaş yavaş yeniden denedi. Çocuğunuz bir işi yapamadığında “henüz” sözcüğünü ve “yavaş yavaş” denemeyi hatırlatabilirsiniz. Bitmiş üründen çok, verdiği emeği övmek azmi destekler."
 },
