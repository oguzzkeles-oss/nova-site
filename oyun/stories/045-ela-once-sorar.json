 "guide": {
  "kazanim": [
   "HSAB.11 Tehlike ve kaza durumlarına karşı kendini koruyabilme: Tehlikeli davranış ve durumlardan kaçınır; ekranda beklenmedik biçimde açılan bir kutuya dokunmadan önce durur ve güvendiği bir büyüğe haber verir.",
   "TAOB.1 Görsel materyalleri seçebilme (TAOB.1.a Sunulan görsel okuma materyallerini inceler; TAOB.1.b Seçenekler arasından seçer): Ekranda açılan yazısız kutuyu ve içindeki hediye resmini inceler, kutunun ne istediğini tahmin eder; “kendim yaparım” ve “önce sorarım” seçenekleri arasından seçim yapar.",
   "OB2 Dijital Okuryazarlık ve D8 Mahremiyet: Fotoğrafının, adının ve evinin kendisine özel olduğunu, tanımadığı ekran kutularıyla paylaşılmayacağını söyler.",
   "SDB3.3 Sorumlu Karar Verme ve E3.8 Soru Sorma: “Dur, sor, birlikte karar ver” adımlarını sırayla uygular; kararsız kaldığında soru sormanın güçlü bir seçim olduğunu fark eder. D16 Sorumluluk: Kendi başına yapabileceği işleri üstlenir."
  ],
  "once": [
   "Kapağı gösterin: “Ela ne yapıyor? Sen tablette ya da telefonda neler oynarsın?”",
   "Bir hediye paketi resmi gösterin (yazısız): “Ekranda böyle bir resim çıksa ne anlatır? Kim göndermiş olabilir?”",
   "“Birine bir şey sormak istediğin oldu mu? Kime sordun?” diye konuşun."
  ],
  "sirasi": [
   "2. sayfada durun: “Ekranda yazı yok, yalnız resim var. Bu kutu Ela'ya ne diyor olabilir?”",
   "3. sayfada Ela'nın kalbine dokunun ve bedenini birlikte inceleyin: “Kalbi küt küt, karnı sıkışık. Bu ne demek olabilir?” Tahminde iki seçeneğin de güvenli olduğunu vurgulayın.",
   "4. sayfada kuralı elle gösterin: avuç öne “Dur”, el kulağın arkasına “Sor”, iki el birleşir “Birlikte karar ver”."
  ],
  "sonra": [
   "Olayları sırayla anlattırın: “Önce ne oldu? Ela ne hissetti? Sonra ne yaptı?”",
   "“Dur, sor, birlikte karar ver” kuralını el hareketleriyle birlikte tekrarlayın.",
   "Neyin özel olduğunu konuşun: fotoğrafımız, adımız, evimizin yeri. “Bunları ekranda tanımadığımız yerlerle paylaşmayız.”"
  ],
  "sinif": {
   "ad": "Kendim mi, Önce Sor mu?",
