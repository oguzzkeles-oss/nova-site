 "guide": {
  "kazanim": [
   "TADB.2 — Dinledikleri/izledikleri materyaller ile ilgili yeni anlamlar oluşturabilme: Deniz'in topu neden sakladığına ve neden geri aldığına ilişkin çıkarım yapar; masaldaki durumu kendi günlük hayatıyla ilişkilendirir (“Ben de bir şeyi yanlışlıkla bozduğumda…”).",
   "TAKB.1 — Konuşma sürecini yönetebilme: Deniz gibi karşısındakinin gözüne bakarak (göz teması kurar) olanı anlatır; sohbet sırasında söz sırasını bekler.",
   "SDB3.3 Sorumlu Karar Verme — “Topu saklamak” ile “dedeye söylemek” arasında düşünür, sonuçlarını tahmin eder ve doğruyu söylemeyi seçer.",
   "E2.2 Sorumluluk — Kazayı üstlenir; eğilen çiçekleri doğrultmaya ve kırılanın yerine tohum ekip her gün sulamaya katılır.",
   "D6 Dürüstlük — Kimse görmese de olanı dürüstçe anlatır; doğruyu söyleyince içinin hafiflediğini fark eder."
  ],
  "once": [
   "Kapaktaki topu ve çiçekleri gösterin: “Bu masalda top ile çiçeklerin başına ne gelebilir?” diye sorun.",
   "“Hiç bir şeyi yanlışlıkla bozdun mu? O zaman ne hissettin?” diye kısa bir sohbet açın; her cevabı yargılamadan dinleyin."
  ],
  "sirasi": [
   "2. sayfada ezilen çiçekleri birlikte sayın: bir, iki, üç. Mor çiçeğin kırıldığını fark edin.",
   "3. sayfadaki tahmin sorusunda iki cevabı da kabul edin; “Neden öyle düşündün?” diye sorun. Kalbe dokunup “güm güm” sesini birlikte taklit edin.",
   "4. sayfada Deniz'le birlikte derin nefes alın: bir… iki… üç…; sonra saklanan topu çocuk bulsun.",
   "5. sayfada Deniz'in dedesinin gözüne baktığını gösterin; dedenin şakasına birlikte gülün, iki çiçeği tek tek doğrultun.",
   "6. sayfada tohuma dokunarak “Her gün sula” deyin; filiz, fide, çiçek aşamalarını birlikte sayın ve Deniz'in yüzündeki ifadeyi konuşun."
  ],
  "sonra": [
   "Deniz topu sakladığında karnındaki düğüm ne oldu? Neden?",
   "Dede, Deniz doğruyu söyleyince ne yaptı? Kızdı mı?",
   "Bir çiçek kırılmıştı. Deniz bunu nasıl telafi etti?"
  ],
  "sinif": {
   "ad": "Düğüm Çözme Çemberi",
   "sure": "20 dk",
   "materyal": "Bir ip parçası, bir saksı, toprak, ayçiçeği ya da fasulye tohumu, sulama kabı",
   "adim": [
    "Çember olun. Öğretmen ipe bir düğüm atsın: “Deniz'in karnındaki düğüm böyleydi.” Çocuklar düğüm olunca bedende neler hissedildiğini söylesin.",
    "İp elden ele dolaşsın; ipi tutan çocuk göz teması kurarak “Bir keresinde … bozmuştum, … dedim” diye kısa bir anısını anlatsın, diğerleri söz sırasını beklesin. İstemeyen “pas” diyebilir.",
    "Sonunda düğümü birlikte çözün ve sınıfça bir saksıya tohum ekin. Her gün sulama sorumlusunu sırayla seçin."
   ]
  },
  "evSoru": [
   "Deniz'in topu neye çarptı?",
   "Deniz neden önce topu sakladı, sonra neden geri aldı?",
   "Sen doğruyu söyledikten sonra nasıl hissedersin?"
  ],
  "evEtk": {
   "ad": "Telafi saksısı",
   "d": "Evde küçük bir saksıya birlikte bir tohum ekin. Sulama işini çocuğunuza verin ve her gün birlikte bakın. Filiz çıkınca Deniz'in ayçiçeğini hatırlayıp “Doğruyu söylediğin bir günü” konuşabilirsiniz."
  },
  "aileNotu": "Bugün “Deniz Doğruyu Söyledi” masalını okuduk. Deniz'in topu dedesinin çiçeklerine çarpıyor; önce saklamak istiyor, sonra doğruyu söylüyor. Dedesi kızmıyor, teşekkür ediyor ve birlikte çiçekleri onarıyorlar. Çocuğunuz bir kazayı itiraf ettiğinde önce “Söylediğin için teşekkür ederim” demeniz, bir dahaki sefere de doğruyu söyleme cesaretini büyütür. Ardından birlikte nasıl düzeltebileceğinizi konuşabilirsiniz."
 },
