 "guide": {
  "kazanim": [
   "TADB.2 (öğrenme çıktısı): Dinledikleri/izledikleri şiir, hikâye, tekerleme gibi materyaller ile ilgili yeni anlamlar oluşturabilme; materyallere ilişkin çıkarım yapar, materyallerdeki bilgilerle günlük hayatı arasında ilişki kurar (süreç bileşenleri). Çocuk, Yumak'ın neden ahırdan çıkmadığını ve Yeşim'in neden şemsiye bulduğunu çıkarır; kendi yağmurlu gün tercihlerini anlatır.",
   "MAB.4 (öğrenme çıktısı): Matematiksel olgu, olay ve nesnelere ilişkin çıkarım yapabilme; MAB.4.b Nesneleri, olguları ve olayları karşılaştırır (süreç bileşeni). Çocuk açık ve kapalı şemsiyeyi, kupkuru Yumak ile sırılsıklam Yeşim'i karşılaştırıp zıt eşlerini bulur.",
   "E3.5 Açık Fikirlilik (eğilim) ve SDB2.3 Sosyal Farkındalık (sosyal-duygusal öğrenme becerisi): Arkadaşının kendisinden farklı bir şeyi sevebileceğini fark eder; farklı tercihleri dinler ve ikisinin de mutlu olacağı bir oyun yolu arar.",
   "D14 Saygı (değer): Yeşim'in Yumak'ı zorlamadan ona şemsiye bulması, Yumak'ın da şemsiyesiyle dışarı çıkıp Yeşim'in birikinti zıplamasına “Bir, iki, üç, zıpla!” diye sayarak katılması üzerinden farklı tercihlere iki yönlü saygıyı ve ortak oyunu görür."
  ],
  "once": [
   "Pencereden bakın ya da bir yağmur resmi gösterin: “Yağmurda dışarı çıkmak mı hoşuna gider, içeride kalmak mı?” Her cevabı kabul edin.",
   "Bir peçeteyi ıslatın, birini kuru bırakın. Çocuk ikisine de dokunsun; birlikte “ıslak” ve “kuru” deyin."
  ],
  "sirasi": [
   "1. sayfada “pıt pıt pıt” ve “şap!” seslerini parmaklarınızla ve avucunuzla birlikte yapın.",
   "2. ve 3. sayfada duyguları adlandırın: “Yumak üşüdü, titredi. Sonra ikisi de kızdı.” Yeşim'in yanak şişirmesini ve Yumak'ın ayak vurmasını birlikte taklit edin.",
   "3. sayfadaki tahmin sorusunda her cevabı kabul edin; “Başka ne yapabilirler?” diye sorun.",
   "4. sayfada önce derin bir nefes alın. Sonra “Şemsiye kapalı” deyin; çocuk dokununca birlikte “Şimdi açık!” diye söyleyin.",
   "5. sayfada Yumak'la birlikte “Bir, iki, üç, zıpla!” diye sayın. Eşleştirmeden önce sorun: “Kim kuru? Kim ıslak?” Çocuk eşleri bulunca zıt sözcükleri yüksek sesle tekrar edin.",
   "6. sayfada güneşe ve birikintiye dokunup “sıcak” ve “soğuk” deyin; sonra kapanış tekerlemesini (“Biri kuru sever, biri ıslak. Ama oyunları hep ortak!”) birlikte söyleyin."
  ],
  "sonra": [
   "Yeşim neyi severdi, Yumak neyi severdi? Badi hangisini severdi?",
   "Yeşim, Yumak'ı zorlamak yerine ne yaptı? Yumak da Yeşim'in oyununa nasıl katıldı?",
   "Senin sevdiğin ama arkadaşının sevmediği bir şey var mı? Birlikte nasıl oynarsınız?"
  ],
  "sinif": {
   "ad": "Zıt Kardeşler Oyunu",
   "sure": "15 dk",
   "materyal": "Bir çocuk şemsiyesi, ıslak ve kuru birer sünger, ılık ve serin su dolu iki kap (öğretmen hazırlar), zıt eş resim kartları (açık–kapalı kapı, ıslak–kuru çorap, sıcak çorba–soğuk ayran)",
   "adim": [
    "Çocuklar çember olur. Öğretmen şemsiyeyi açıp kapatır; çocuklar hep birlikte “Açık!”, “Kapalı!” diye söyler.",
    "Süngerler ve su kapları elden ele dolaşır. Çocuklar dokunup “ıslak–kuru”, “sıcak–soğuk” der.",
    "Resim kartları yere karışık konur. Her çocuk bir kart seçer, zıt eşini bulur ve iki sözcüğü söyler.",
    "Kapanışta her çocuk “Ben ... severim.” der. Arkadaşı “Sen ... seversin, ben de ... severim.” diye karşılık verir; kimse “Olmaz!” demez."
   ]
  },
  "evSoru": [
   "Yumak neden şemsiyenin altına girdi?",
   "Yeşim neden birikintiyi seviyordu?",
   "Evde kim sıcak çorba sever, kim soğuk ayran?"
  ],
  "evEtk": {
   "ad": "Evde Zıt Avı",
   "d": "Evde birlikte zıt eşler arayın: açık–kapalı kapı, ıslak–kuru havlu, ılık–serin musluk suyu. Her eşi bulunca el çırpıp iki sözcüğü söyleyin. Sonra her aile bireyi sırayla “Ben ... severim” desin; diğerleri “Olmaz!” demeden dinlesin."
  },
  "aileNotu": "Bugün “Islak mı, Kuru mu?” masalını okuduk. Kurbağa Yeşim ıslak birikintileri, kuzu Yumak ise kuru kalmayı seviyordu; önce tartıştılar, sonra bir şemsiyeyle ikisinin de mutlu olduğu ortak bir oyun buldular. Çocuklarımız ıslak–kuru, sıcak–soğuk, açık–kapalı gibi zıt sözcükleri eşleştirdi ve farklı tercihlere saygıyı konuştu. Evde birlikte zıt avı yapabilir, her aile bireyinin neyi sevdiğini dinleyebilirsiniz."
 },
