 "guide": {
  "kazanim": [
   "FAB.1 — Gündelik yaşamda fenle ilgili olaylara/olgulara ve durumlara yönelik bilimsel gözlem yapabilme: Çocuk bardaktaki buzun suya dönüşmesini gözler; güneşteki ve gölgedeki bardağı karşılaştırır.",
   "FAB.3 (teyitsiz) — Günlük yaşamında fen olaylarına yönelik bilimsel gözleme dayalı tahminlerde bulunabilme: İlk gözlemine (pencere önündeki bardak) dayanarak hangi buzun önce eriyeceğini tahmin eder.",
   "E1.1 Merak ve SDB1.3 Kendine Uyarlama (Öz Yansıtma): 'Buz nereye gitti?' sorusunun peşine düşer; tahmini ile sonucu karşılaştırır, 'Ben ne demiştim, ne oldu?' diye kendi düşüncesini gözden geçirir.",
   "D12 Sabır: Sabırsızlandığını fark eder; derin nefes alıp çiçekleri sayarak bekler ve beklemenin bir işe yaradığını deneyimler."
  ],
  "once": [
   "Kapaktaki başlığı okuyun: 'Buz nereye gitti?' Sizce buz bir yere gidebilir mi?",
   "Bir buz kalıbını gösterin ya da hatırlatın: Buz soğuk mu, sıcak mı? Elimizde tutunca ne olur?"
  ],
  "sirasi": [
   "2. sayfada durun: Ela'nın bardağında buz yok, yalnızca su var. Çocuğun ilk açıklamalarını yargılamadan dinleyin.",
   "3. sayfadaki tahmin sorusunda çocuğun seçimini ve nedenini sorun ('Neden güneştekini seçtin?'). İki cevap da düşünmeye değer.",
   "4. sayfada Ela'nın sabırsızlığını birlikte canlandırın: kıpır kıpır olun, sonra derin bir nefes alıp çiçekleri sayın.",
   "5. sayfada tahmini sonuçla karşılaştırın: 'Sen ne demiştin? Ne oldu?'"
  ],
  "sonra": [
   "'Buz nereye gitti?' sorusunu yeniden sorun; çocuğun 'Su oldu.' cevabına kendi sözcükleriyle ulaşmasını bekleyin.",
   "Güneşte ve gölgede beklemenin nasıl bir his olduğunu konuşun: Hangisinde daha çok terleriz?",
   "Ela'nın beklerken ne yaptığını hatırlayın; siz beklerken ne yapabilirsiniz, birlikte liste yapın."
  ],
  "sinif": {
   "ad": "Güneşte mi, Gölgede mi? Buz Deneyi",
   "sure": "30–40 dk (arada başka etkinlikle)",
   "materyal": "Aynı büyüklükte buz küpleri, iki şeffaf plastik kap, güneşli bir pencere önü ya da bahçe, gölgeli bir köşe, güneş ve bulut resimli iki kart, kum saati ya da şarkı",
   "adim": [
    "Çocuklara buz küplerini gösterin; kısa süre dokunup bırakmalarını, 'soğuk, sert, kaygan' gibi sözcüklerle anlatmalarını isteyin. Buzu ağza almıyoruz.",
    "Bir kabı güneşe (güneş kartı), birini gölgeye (bulut kartı) koyun. Her çocuk hangisinin önce eriyeceğini tahmin edip mandalını o kartın yanına takar.",
    "Beklerken bir şarkı söyleyin, parmak oyunu ya da başka bir etkinlik yapın; ara ara kaplara birlikte bakın.",
    "Sonuçta tahmin mandallarını sayın, sonucu karşılaştırın; eriyen suyla sınıftaki bitkileri sulayın."
   ]
  },
  "evSoru": [
   "Buz nereye gitti? Ne oldu?",
   "Hangi buz önce eridi? Neden?",
   "Ela beklerken ne yaptı? Sen beklerken ne yaparsın?"
  ],
  "evEtk": {
   "ad": "Mutfakta Buz Gözlemi",
   "d": "İki küçük tabağa birer buz küpü koyun: birini güneş alan pencerenin önüne, birini gölgeli bir yere. Çocuğunuzla önce tahmin edin, sonra ara ara birlikte bakın. Eriyen suyu çiçeklere verin. Küçük buz parçalarını ağza almamasına dikkat edin; buzu uzun süre elde tutmayın."
  },
  "aileNotu": "Bugün 'Buz Nereye Gitti?' masalını okuduk. Ela bardaktaki buzun suya dönüştüğünü gördü; bir bardağı güneşe, birini ağacın gölgesine koyup hangisinin önce eriyeceğini tahmin etti. Beklerken sabırsızlandı, nefes alıp çiçekleri sayarak bekledi. Evde buzla küçük bir deney yapıp çocuğunuzun tahminini ve gözlemini dinleyebilirsiniz."
 },
