{
 "id": "tosbi",
 "lang": "en",
 "title": "Shelly Takes Her Time",
 "blurb": "Everyone laughs at how slow Shelly is. But one day, being slow and careful turns out to be very useful.",
 "pages": [
  {
   "text": "Shelly the tortoise walked slowly. Step, step, one more step.",
   "hits": {
    "bfly": "A butterfly! Fly, butterfly, fly!"
   },
   "mech": {
    "done": "“Step, step, one more step!”"
   },
   "hint": "Touch Shelly to make her walk!",
   "ask": "Why do tortoises walk slowly? Can you walk slowly?"
  },
  {
   "text": "Hoppy the rabbit giggled, tee-hee-hee: “You're so slow, Shelly!” Shelly felt upset.",
   "hits": {
    "zip": "“Tee-hee-hee!”",
    "tosbi": "“I'm hiding in my shell…”"
   },
   "hint": "Touch Hoppy!",
   "ask": "How did Shelly feel? How do you feel when someone laughs at you?"
  },
  {
   "text": "One day all the animals went for a picnic by the lake. Hoppy ran hop, hop, hop and got right to the front.",
   "hits": {
    "lake": "Splash! A fish jumped.",
    "zip": "“Hop hop hop!”",
    "tosbi": "“Hello, I'm Shelly.”"
   },
   "hint": "Touch the lake. What will happen?",
   "ask": "Why might Hoppy be in such a hurry?"
  },
  {
   "text": "As Hoppy ran, he dropped his basket! The apples rolled into the grass. “Oh no!” Hoppy looked around in a fluster, but he couldn't see the apples.",
   "hits": {
    "zip": "“Oh no, my apples!”"
   },
   "mech": {
    "done": "Five apples! You counted them all."
   },
   "predict": {
    "q": "Who do you think will pick up the apples?",
    "res": "Hmm, interesting! Let's turn the page.",
    "opts": [
     "Shelly helps",
     "Hoppy picks them up by himself"
    ]
   },
   "hint": "Count the apples: touch them one by one!",
   "ask": "How many apples fell? Let's count together."
  },
  {
   "text": "Shelly came along slowly. She found every apple, one by one. “When I walk slowly, I see everything.”",
   "hits": {
    "tosbi": "“Hello, I'm Shelly.”"
   },
   "mech": {
    "done": "“I've picked them all up. Here you are, Hoppy!”"
   },
   "hint": "Put the apples in the basket!",
   "ask": "What might be good about being slow?"
  },
  {
   "text": "Hoppy felt ashamed. “I'm sorry, Shelly. You're slow, but you're very careful.” They ate apples together by the lake.",
   "hits": {
    "tosbi": "“Enjoy!”",
    "zip": "“Now we're best friends!”",
    "ap": "“Enjoy!”"
   },
   "hint": "Touch the friends!",
   "ask": "Why did Hoppy say sorry? How do you say sorry?"
  }
 ],
 "guide": {
  "kazanim": [
   "Shows respect for individual differences.",
   "Says sorry after making a mistake, and accepts an apology.",
   "Tells opposites apart (fast–slow).",
   "Counts objects and gathers them in one place (the apples)."
  ],
  "once": [
   "Ask: “Is it better to be fast or slow?” and note down the answers.",
   "Talk about what they know about tortoises and rabbits."
  ],
  "sirasi": [
   "On page 4, count the apples together; on page 5, collect them into the basket.",
   "For the prediction question, draw the different answers on the board."
  ],
  "sonra": [
   "Has our answer from before the story changed?",
   "Everyone has a strength. What's yours?",
   "What would you do if you were Hoppy?"
  ],
  "sinif": {
   "ad": "Fast–Slow Movement Game",
   "sure": "20 min",
   "materyal": "Music, paper, crayons",
   "adim": [
    "When the music speeds up, hop like a rabbit; when it slows down, walk like a tortoise.",
    "The children pair up and tell each other one of their strengths.",
    "Each child draws a “My strength” picture; make a display board."
   ]
  },
  "evSoru": [
   "What was Shelly's strength?",
