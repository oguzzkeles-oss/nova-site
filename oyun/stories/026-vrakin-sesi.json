 "guide": {
  "kazanim": [
   "TADB.4 Dinledikleri/izledikleri materyaller ve dinleme/izleme ortamına ilişkin görüşlerini yansıtabilme: Masala ilişkin duygu ve düşüncelerini söyler; ortamda kendisini rahatsız eden etkenleri (ses düzeyi) fark edip söyler (“Kocaman ses yavruların uykusunu kaçırdı.”).",
   "TAKB.1 Konuşma sürecini yönetebilme: Konuşmaya uygun selamlama ifadeleriyle başlar ve bitirir (“Günaydın göl!”, “İyi uykular.”).",
   "E2.1 Empati: Uykusu kaçan yavruların ve üzülen Vrak'ın duygularını yüzlerinden okur, adını söyler.",
   "SDB1.2 Kendini Düzenleme: Derin nefes alıp sesini kısmak gibi bir yolla davranışını ortama göre düzenler.",
   "D14 Saygı: Başkalarının dinlenme ihtiyacına saygı gösterir; biri uyurken sesini kısar, özür diler. (D5 Duyarlılık, teyitsiz, ikincil değer.)"
  ],
  "once": [
   "Kapaktaki kurbağayı göster: “Bu kurbağanın adı Vrak. Sence sesi nasıldır?”",
   "İki sesi birlikte deneyin: önce kocaman bir “VRAK!”, sonra minicik bir fısıltı “vrak…”. Farkı konuşun.",
   "“Evde biri uyurken nasıl konuşuruz?” diye sor, cevapları dinle."
  ],
  "sirasi": [
   "1. sayfada Vrak'a dokunun, hep birlikte “VRAAAK!” deyin. Balık bile zıpladı; ne kadar gür bir ses! Serçe Cik'i de tanıyın.",
   "2. sayfada durun: “Yavruların uykusu neden kaçtı?” Çocuk gürültüyle ilgili düşüncesini söylesin.",
   "3. sayfadaki tahminde iki seçenek de iyi bir fikir. “Sen olsan ne yapardın?” diye sor.",
   "4. sayfada yavruları parmakla sayarken fısıldayın: “Bir… iki… üç… Şşşt!”",
   "5. sayfada Vrak'ı zıplatırken parmak ucunda, sessizce “hop, hop, hop” deyin; varınca kocaman bir “VRAAAK!”",
   "6. sayfada her nesneyi seçmeden önce sorun: “Bu uyku mu, oyun mu? Minicik ses mi, kocaman ses mi?”",
   "7. sayfada önce kocaman sesle şarkıya katılın, sonra aynı şarkıyı minicik sesle tekrarlayın."
  ],
  "sonra": [
   "Yavrular neden uyandı? Vrak ne yapınca yeniden uyudular?",
   "Vrak'ın iki sesi neydi? Sen kocaman sesini nerede kullanırsın?",
   "Seni hangi sesler rahatsız eder? Rahatsız olunca ne söyleyebilirsin?",
   "Masalı resimlerle sıralayın: yavrular uyanıyor, Vrak fısıldıyor, hep birlikte şarkı."
  ],
  "sinif": {
   "ad": "Kocaman Ses, Minicik Ses",
   "sure": "15 dk",
   "materyal": "Yazısız iki resim kartı (açık bir çayır ve bir kuş yuvası), bir yastık",
   "adim": [
    "Çember olun. Çayır kartı kalkınca kocaman sesle “VRAK!”, yuva kartı kalkınca fısıltıyla “vrak…” deyin.",
    "“Ali Baba'nın Çiftliği” şarkısını önce kocaman, sonra minicik sesle söyleyin. Ördek bölümünde “vak vak” deyin.",
    "“Uyuyan yavru” oyunu: Bir çocuk başını yastığa koysun. Ötekiler parmak ucunda gelip fısıldasın: “İyi uykular.” Sonra sıra değişsin.",
    "Sınıfta nerede kocaman, nerede minicik ses kullanırız? Bahçe, dinlenme ve kitap köşesi için birlikte karar verin."
   ]
  },
  "evSoru": [
   "Vrak'ın sesi yavruları neden uyandırdı?",
   "Vrak özür dileyince ne oldu?",
   "Bizim evde kocaman ses nerede, minicik ses nerede?"
  ],
  "evEtk": {
   "ad": "Evde ses haritası",
   "d": "Evi birlikte gezin. Her odada durup sorun: “Burada kocaman ses mi, minicik ses mi?” Balkonda ya da parkta kocaman bir “VRAK!” şarkısı söyleyin; biri uyurken fısıltıyla “iyi uykular” deyin. Çocuğunuz sesini ayarlayınca fark ettiğinizi söyleyin: “Fısıldadın, kardeşin rahat uyudu.”"
  },
  "aileNotu": "Bugün “Vrak'ın Kocaman Sesi” masalını okuduk. Kurbağa Vrak'ın kocaman sesi uyuyan ördek yavrularını uyandırdı; Vrak derin bir nefes alıp fısıldamayı, şarkısını da çayırda söylemeyi buldu. Evde “kocaman ses, minicik ses” oyununu oynayabilirsiniz. Çocuğunuzun gür sesini susturmak yerine ona uygun bir yer gösterin; sesini ayarladığında bunu fark ettiğinizi söyleyin."
 },
